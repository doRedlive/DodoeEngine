{
  "cmake.configurePreset": "msvc-debug",
  "cmake.buildPreset": "msvc-debug-cakery",
  // C# scripts are compiled by Dodoe into this generated project. Point the
  // language service at it so IntelliSense can resolve GreenCake types.
  "dotnet.defaultSolution": "${workspaceFolder}/DodoeScripts.sln",
  "files.exclude": {
    "**/obj": true
  },
  "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",
  "C_Cpp.default.includePath": [
    "${workspaceFolder}/engine/src",
    "${workspaceFolder}/engine/src/runtime",
    "${workspaceFolder}/engine/src/editor/cakery",
    "C:/Qt/6.11.1/msvc2022_64/include",
    "C:/Qt/6.11.1/msvc2022_64/include/QtCore",
    "C:/Qt/6.11.1/msvc2022_64/include/QtGui",
    "C:/Qt/6.11.1/msvc2022_64/include/QtWidgets"
  ]
}
