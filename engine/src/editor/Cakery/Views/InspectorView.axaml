<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cakery.ViewModels"
             x:Class="Cakery.Views.InspectorView"
             x:DataType="vm:InspectorViewModel">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="4">
        <TextBlock Grid.Row="0" Text="Inspector" FontWeight="Bold" Margin="0,0,0,4"/>

        <TextBox Grid.Row="1" Text="{Binding EntityName}" PlaceholderText="Entity Name" Margin="0,0,0,8"/>

        <ScrollViewer Grid.Row="2">
            <ItemsControl ItemsSource="{Binding Components}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderThickness="1" BorderBrush="#333" CornerRadius="4" Margin="0,2" Padding="6">
                            <Grid RowDefinitions="Auto,Auto">
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="{Binding TypeName}" FontWeight="SemiBold"/>
                                </StackPanel>

                                <ContentControl Grid.Row="1" Content="{Binding}" Margin="8,4,0,0"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="3" Spacing="4" Margin="0,4,0,0">
            <Button Content="Add Component" Command="{Binding ToggleAddComponentCommand}"/>
        </StackPanel>
    </Grid>
</UserControl>
