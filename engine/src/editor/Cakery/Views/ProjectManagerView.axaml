<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cakery.ViewModels"
             xmlns:local="using:Cakery.Views"
             x:Class="Cakery.Views.ProjectManagerView"
             x:DataType="vm:ProjectManagerViewModel"
             Background="#1A1A1A">

    <!-- ============================================================ -->
    <!-- Styles                                                       -->
    <!-- ============================================================ -->
    <UserControl.Styles>
        <Style Selector="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#2A2A2A"/>
        </Style>
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="#1A3A5C"/>
        </Style>
        <Style Selector="ListBoxItem:selected:focus /template/ ContentPresenter">
            <Setter Property="Background" Value="#1E4A6E"/>
        </Style>
        <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#1E4A6E"/>
        </Style>
    </UserControl.Styles>

    <!-- ============================================================ -->
    <!-- Root grid                                                    -->
    <!-- ============================================================ -->
    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ======================================================== -->
        <!-- Row 0: Top Bar                                           -->
        <!-- ======================================================== -->
        <Border Grid.Row="0" Background="#1E1E1E" Padding="20,14"
                BorderThickness="0,0,0,1" BorderBrush="#333">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- Left: branding -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Cakery Engine" FontSize="20"
                               FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Project Manager" FontSize="12"
                               Foreground="#888" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Right: controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            Spacing="8" VerticalAlignment="Center">
                    <!-- Sort dropdown -->
                    <ComboBox SelectedIndex="{Binding SortOptionIndex, Mode=TwoWay}"
                              Width="120" FontSize="12" VerticalAlignment="Center"
                              Background="#2A2A2A" BorderBrush="#444">
                        <ComboBoxItem Content="Last Edited"/>
                        <ComboBoxItem Content="Name"/>
                        <ComboBoxItem Content="Path"/>
                    </ComboBox>

                    <!-- Search -->
                    <TextBox Text="{Binding SearchText}" Width="180"
                             FontSize="12" Padding="6,4"
                             Background="#2A2A2A" BorderBrush="#444"
                             PlaceholderText="Filter projects..."
                             VerticalAlignment="Center"/>

                    <!-- Action buttons -->
                    <Button Content="New" Command="{Binding ShowNewDialogCommand}"
                            Width="64" Height="28" FontSize="12"
                            Background="#1E90FF" Foreground="White"/>
                    <Button Content="Import" Click="ImportFile_Click"
                            Width="64" Height="28" FontSize="12"/>
                    <Button Content="Scan" Click="ScanFolder_Click"
                            Width="64" Height="28" FontSize="12"/>
                    <Button Content="Clear Missing"
                            Command="{Binding ShowRemoveMissingDialogCommand}"
                            IsVisible="{Binding HasMissingProjects}"
                            Width="100" Height="28" FontSize="11"
                            Foreground="#CC4444"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ======================================================== -->
        <!-- Row 1: Main Content (list + detail)                      -->
        <!-- ======================================================== -->
        <Grid Grid.Row="1" ColumnDefinitions="3*,2*" Background="#1A1A1A">

            <!-- ================================================ -->
            <!-- Column 0: Project list                          -->
            <!-- ================================================ -->
            <Grid Grid.Column="0" RowDefinitions="Auto,*">
                <!-- Column headers -->
                <Border Grid.Row="0" Background="#222" Padding="16,8"
                        BorderThickness="0,0,0,1" BorderBrush="#333">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <TextBlock Grid.Column="0" Text="★" Width="28"
                                   Foreground="#888" FontSize="11"/>
                        <TextBlock Grid.Column="1" Text="Project"
                                   Foreground="#888" FontSize="11"/>
                        <TextBlock Grid.Column="2" Text="Modified"
                                   Foreground="#888" FontSize="11" Width="140"/>
                    </Grid>
                </Border>

                <!-- Scrollable list -->
                <ScrollViewer Grid.Row="1" Background="Transparent">
                    <Grid>
                    <!-- Empty state (shown when the filtered list is empty) -->
                    <Border IsVisible="{Binding IsListEmpty}"
                            Padding="40" VerticalAlignment="Center"
                            HorizontalAlignment="Center" Name="EmptyState">
                        <StackPanel Spacing="16">
                            <Ellipse Width="64" Height="64" Fill="#2A2A2A"
                                     HorizontalAlignment="Center"/>
                            <TextBlock Text="No Projects Yet"
                                       FontSize="22" FontWeight="SemiBold"
                                       Foreground="#AAA"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Create a new project, import an existing one,&#x0a;or scan a folder for projects."
                                       FontSize="13" Foreground="#666"
                                       TextWrapping="Wrap" MaxWidth="320"
                                       TextAlignment="Center" LineHeight="20"/>
                            <WrapPanel HorizontalAlignment="Center"
                                       Margin="0,8,0,0">
                                <Button Content="New Project"
                                        Command="{Binding ShowNewDialogCommand}"
                                        Width="120" Height="34" FontSize="13"
                                        Background="#1E90FF" Foreground="White"
                                        Margin="0,0,5,5"/>
                                <Button Content="Import" Click="ImportFile_Click"
                                        Width="120" Height="34" FontSize="13"
                                        Margin="0,0,5,5"/>
                                <Button Content="Scan Folder" Click="ScanFolder_Click"
                                        Width="120" Height="34" FontSize="13"
                                        Margin="0,0,5,5"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Project list (hidden when empty) -->
                    <ListBox ItemsSource="{Binding FilteredProjects}"
                             IsVisible="{Binding !IsListEmpty}"
                             SelectedItem="{Binding Selected, Mode=TwoWay}"
                             Background="Transparent" BorderThickness="0"
                             Name="ProjectListBox">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:ProjectEntry">
                                <Border Padding="16,10" Background="Transparent"
                                        Opacity="{Binding RowOpacity}">
                                    <Grid ColumnDefinitions="Auto,*,Auto"
                                          RowDefinitions="Auto,Auto">
                                        <!-- Icon placeholder -->
                                        <Ellipse Grid.Column="0" Grid.RowSpan="2"
                                                 Width="36" Height="36"
                                                 Fill="#333"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,14,0"/>

                                        <!-- Name (bold) -->
                                        <TextBlock Grid.Column="1" Grid.Row="0"
                                                   Text="{Binding Name}"
                                                   FontSize="14" FontWeight="SemiBold"
                                                   Foreground="White"
                                                   VerticalAlignment="Center"/>

                                        <!-- Path (muted) -->
                                        <TextBlock Grid.Column="1" Grid.Row="1"
                                                   Text="{Binding ProjectFile}"
                                                   FontSize="11" Foreground="#666"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,2,0,0"/>

                                        <!-- Missing badge -->
                                        <Border Grid.Column="1" Grid.Row="0"
                                                Grid.RowSpan="2"
                                                Background="#442222" CornerRadius="3"
                                                Padding="8,2"
                                                IsVisible="{Binding IsMissing}"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Margin="0,2,0,0">
                                            <TextBlock Text="MISSING" FontSize="9"
                                                       Foreground="#CC4444"
                                                       FontWeight="SemiBold"/>
                                        </Border>

                                        <!-- Date -->
                                        <TextBlock Grid.Column="2" Grid.RowSpan="2"
                                                   Text="{Binding DisplayDate}"
                                                   FontSize="12" Foreground="#888"
                                                   VerticalAlignment="Center"
                                                   Width="140"
                                                   TextAlignment="Right"
                                                   Margin="8,0"/>

                                        <!-- Star -->
                                        <Button Grid.Column="0" Grid.RowSpan="2"
                                                Content="★"
                                                Width="28" Height="28"
                                                FontSize="14"
                                                Foreground="{Binding StarColor}"
                                                Background="Transparent"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                IsVisible="{Binding ShowStar}"
                                                IsHitTestVisible="False"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    </Grid>
                </ScrollViewer>
            </Grid>

            <!-- ================================================ -->
            <!-- Column 1: Detail / Empty-state right panel      -->
            <!-- ================================================ -->

            <!-- Detail panel (when a project is selected) -->
            <Border Grid.Column="1" Background="#222" Padding="28"
                    IsVisible="{Binding IsAnyProjectSelected}"
                    BorderThickness="1,0,0,0" BorderBrush="#333">
                <ScrollViewer>
                    <StackPanel Spacing="14" VerticalAlignment="Top">
                        <!-- Large icon -->
                        <Ellipse Width="72" Height="72" Fill="#333"
                                 HorizontalAlignment="Center" Margin="0,0,0,4"/>

                        <!-- Name -->
                        <TextBlock Text="{Binding Selected.Name}"
                                   FontSize="22" FontWeight="Bold"
                                   Foreground="White" TextWrapping="Wrap"
                                   TextAlignment="Center"/>

                        <!-- Description -->
                        <TextBlock Text="{Binding Selected.Description, FallbackValue=''}"
                                   FontSize="12" Foreground="#888"
                                   TextWrapping="Wrap" TextAlignment="Center"
                                   MaxWidth="280"/>

                        <!-- Separator -->
                        <Border Height="1" Background="#333" Margin="0,6"/>

                        <!-- Location -->
                        <StackPanel Spacing="2">
                            <TextBlock Text="Location" FontSize="10"
                                       Foreground="#555"/>
                            <TextBlock Text="{Binding Selected.ProjectPath, FallbackValue=''}"
                                       FontSize="11" Foreground="#999"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- Last modified -->
                        <StackPanel Spacing="2">
                            <TextBlock Text="Last Modified" FontSize="10"
                                       Foreground="#555"/>
                            <TextBlock Text="{Binding Selected.DisplayDate, FallbackValue=''}"
                                       FontSize="11" Foreground="#999"/>
                        </StackPanel>

                        <!-- Engine version (if available) -->
                        <StackPanel Spacing="2"
                                    IsVisible="{Binding !!Selected.EngineVersion}">
                            <TextBlock Text="Engine" FontSize="10"
                                       Foreground="#555"/>
                            <TextBlock Text="{Binding Selected.EngineVersion, FallbackValue=''}"
                                       FontSize="11" Foreground="#999"/>
                        </StackPanel>

                        <!-- Separator -->
                        <Border Height="1" Background="#333" Margin="0,6"/>

                        <!-- Action buttons (only for existing projects) -->
                        <StackPanel Spacing="6"
                                    IsVisible="{Binding !IsSelectedProjectMissing}">
                            <Button Content="Open"
                                    Command="{Binding OpenProjectCommand}"
                                    Height="38" FontSize="14"
                                    Background="#1E90FF" Foreground="White"/>
                            <Button Content="Rename"
                                    Command="{Binding ShowRenameDialogCommand}"
                                    Height="30" FontSize="12"/>
                            <Button Content="Show in Explorer"
                                    Command="{Binding ShowInExplorerCommand}"
                                    Height="30" FontSize="12"/>
                            <CheckBox Content="Pinned"
                                      IsChecked="{Binding Selected.Pinned}"
                                      Command="{Binding TogglePinCommand}"
                                      Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- Management actions (always visible when selected) -->
                        <Border Height="1" Background="#333" Margin="0,4"/>
                        <StackPanel Spacing="4">
                            <Button Content="Remove from List"
                                    Command="{Binding ShowRemoveFromListDialogCommand}"
                                    Height="28" FontSize="11"
                                    Foreground="#CC9966" Background="Transparent"
                                    HorizontalContentAlignment="Center"/>
                            <Button Content="Delete from Disk"
                                    Command="{Binding ShowDeleteFromDiskDialogCommand}"
                                    Height="28" FontSize="11"
                                    Foreground="#CC4444" Background="Transparent"
                                    HorizontalContentAlignment="Center"
                                    IsVisible="{Binding !IsSelectedProjectMissing}"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Empty state (nothing selected) -->
            <Border Grid.Column="1" Background="#222" Padding="28"
                    IsVisible="{Binding !IsAnyProjectSelected}"
                    BorderThickness="1,0,0,0" BorderBrush="#333">
                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center" Spacing="16">
                    <Ellipse Width="56" Height="56" Fill="#2A2A2A"
                             HorizontalAlignment="Center"/>
                    <TextBlock Text="No Project Selected"
                               FontSize="18" FontWeight="SemiBold"
                               Foreground="#AAA"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Select a project from the list&#x0a;or create a new one."
                               FontSize="12" Foreground="#666"
                               TextWrapping="Wrap" MaxWidth="240"
                               TextAlignment="Center" LineHeight="18"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ======================================================== -->
        <!-- Row 2: Footer                                            -->
        <!-- ======================================================== -->
        <Border Grid.Row="2" Background="#1E1E1E" Padding="16,8"
                BorderThickness="0,1,0,0" BorderBrush="#333">
            <StackPanel Orientation="Horizontal" Spacing="16">
                <TextBlock FontSize="11" Foreground="#888">
                    <Run Text="{Binding TotalProjectCount}"/> projects
                </TextBlock>
                <TextBlock FontSize="11" Foreground="#CC4444"
                           IsVisible="{Binding HasMissingProjects}">
                    • <Run Text="{Binding MissingProjectCount}"/> missing
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- ======================================================== -->
        <!-- POPUPS (overlays spanning all rows)                      -->
        <!-- ======================================================== -->

        <!-- New Project popup -->
        <Border Grid.Row="0" Grid.RowSpan="3" Grid.ColumnSpan="2"
                Background="#AA000000" IsVisible="{Binding ShowNewPopup}">
            <Border Width="520" Height="340" Background="#2A2A2A"
                    CornerRadius="8" HorizontalAlignment="Center"
                    VerticalAlignment="Center" Padding="28">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,*">
                    <TextBlock Grid.Row="0" Text="Create New Project"
                               FontSize="20" FontWeight="Bold"
                               Foreground="White" Margin="0,0,0,20"/>

                    <StackPanel Grid.Row="1" Spacing="4" Margin="0,0,0,14">
                        <TextBlock Text="Project Name" Foreground="#888"
                                   FontSize="12"/>
                        <TextBox Text="{Binding NewName}" FontSize="14"
                                 Padding="6"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Spacing="4" Margin="0,0,0,14">
                        <TextBlock Text="Project Location" Foreground="#888"
                                   FontSize="12"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox Grid.Column="0"
                                     Text="{Binding NewLocation}"
                                     FontSize="12" Padding="6"
                                     Margin="0,0,8,0"/>
                            <Button Grid.Column="1" Content="Browse"
                                    Width="70" Height="30" FontSize="11"
                                    Click="BrowseNewLocation_Click"/>
                        </Grid>
                    </StackPanel>

                    <TextBlock Grid.Row="3"
                               Text="Creates Assets/Scenes, Binaries, Configs folders"
                               Foreground="#666" FontSize="11"
                               Margin="0,0,0,14"/>

                    <StackPanel Grid.Row="4" Orientation="Horizontal"
                                Spacing="8" HorizontalAlignment="Right"
                                VerticalAlignment="Bottom">
                        <Button Content="Cancel"
                                Command="{Binding CancelNewCommand}"
                                Width="80" Height="32"/>
                        <Button Content="Create"
                                Command="{Binding CreateNewProjectCommand}"
                                Width="80" Height="32"
                                Background="#1E90FF" Foreground="White"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>

        <!-- Rename popup -->
        <Border Grid.Row="0" Grid.RowSpan="3" Grid.ColumnSpan="2"
                Background="#AA000000" IsVisible="{Binding ShowRenamePopup}">
            <Border Width="420" Height="170" Background="#2A2A2A"
                    CornerRadius="8" HorizontalAlignment="Center"
                    VerticalAlignment="Center" Padding="24">
                <Grid RowDefinitions="Auto,Auto,*">
                    <TextBlock Grid.Row="0" Text="Rename Project"
                               FontSize="18" FontWeight="Bold"
                               Foreground="White" Margin="0,0,0,14"/>
                    <TextBox Grid.Row="1" Text="{Binding RenameText}"
                             FontSize="14" Padding="6"
                             Margin="0,0,0,14"/>
                    <StackPanel Grid.Row="2" Orientation="Horizontal"
                                Spacing="8" HorizontalAlignment="Right"
                                VerticalAlignment="Bottom">
                        <Button Content="Cancel"
                                Command="{Binding CancelRenameCommand}"
                                Width="80" Height="32"/>
                        <Button Content="Rename"
                                Command="{Binding ConfirmRenameCommand}"
                                Width="80" Height="32"
                                Background="#1E90FF" Foreground="White"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>

        <!-- Remove from List popup -->
        <Border Grid.Row="0" Grid.RowSpan="3" Grid.ColumnSpan="2"
                Background="#AA000000" IsVisible="{Binding ShowRemoveConfirmPopup}">
            <Border Width="440" Height="180" Background="#2A2A2A"
                    CornerRadius="8" HorizontalAlignment="Center"
                    VerticalAlignment="Center" Padding="24">
                <Grid RowDefinitions="Auto,Auto,*">
                    <TextBlock Grid.Row="0" Text="Remove from List"
                               FontSize="18" FontWeight="Bold"
                               Foreground="White" Margin="0,0,0,10"/>
                    <StackPanel Grid.Row="1" Spacing="6">
                        <TextBlock Text="Remove this project from the list?"
                                   Foreground="#CCC" FontSize="13"/>
                        <TextBlock Text="No files will be deleted from disk."
                                   Foreground="#888" FontSize="12"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Orientation="Horizontal"
                                Spacing="8" HorizontalAlignment="Right"
                                VerticalAlignment="Bottom">
                        <Button Content="Cancel"
                                Command="{Binding CancelRemoveFromListCommand}"
                                Width="80" Height="32"/>
                        <Button Content="Remove"
                                Command="{Binding ConfirmRemoveFromListCommand}"
                                Width="80" Height="32"
                                Background="#CC8833" Foreground="White"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>

        <!-- Delete from Disk popup -->
        <Border Grid.Row="0" Grid.RowSpan="3" Grid.ColumnSpan="2"
                Background="#AA000000" IsVisible="{Binding ShowDeleteFromDiskPopup}">
            <Border Width="460" Height="230" Background="#2A2A2A"
                    CornerRadius="8" HorizontalAlignment="Center"
                    VerticalAlignment="Center" Padding="24">
                <Grid RowDefinitions="Auto,Auto,Auto,*">
                    <TextBlock Grid.Row="0" Text="Delete from Disk"
                               FontSize="18" FontWeight="Bold"
                               Foreground="#CC4444" Margin="0,0,0,10"/>
                    <StackPanel Grid.Row="1" Spacing="6" Margin="0,0,0,14">
                        <TextBlock Text="This will PERMANENTLY delete the entire project folder including all files."
                                   Foreground="#CCC" FontSize="13"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="This action cannot be undone!"
                                   Foreground="#CC4444" FontSize="12"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                    <TextBlock Grid.Row="2"
                               Text="{Binding Selected.ProjectPath, FallbackValue=''}"
                               Foreground="#888" FontSize="11"
                               TextWrapping="Wrap" Margin="0,0,0,14"/>
                    <StackPanel Grid.Row="3" Orientation="Horizontal"
                                Spacing="8" HorizontalAlignment="Right"
                                VerticalAlignment="Bottom">
                        <Button Content="Cancel"
                                Command="{Binding CancelDeleteFromDiskCommand}"
                                Width="80" Height="32"/>
                        <Button Content="Delete Forever"
                                Command="{Binding ConfirmDeleteFromDiskCommand}"
                                Width="120" Height="32"
                                Background="#CC3333" Foreground="White"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>

        <!-- Remove Missing popup -->
        <Border Grid.Row="0" Grid.RowSpan="3" Grid.ColumnSpan="2"
                Background="#AA000000" IsVisible="{Binding ShowRemoveMissingPopup}">
            <Border Width="440" Height="180" Background="#2A2A2A"
                    CornerRadius="8" HorizontalAlignment="Center"
                    VerticalAlignment="Center" Padding="24">
                <Grid RowDefinitions="Auto,Auto,*">
                    <TextBlock Grid.Row="0" Text="Clear Missing Projects"
                               FontSize="18" FontWeight="Bold"
                               Foreground="White" Margin="0,0,0,10"/>
                    <StackPanel Grid.Row="1" Spacing="6">
                        <TextBlock Foreground="#CCC" FontSize="13">
                            <Run>Remove all </Run>
                            <Run Text="{Binding MissingProjectCount}"/>
                            <Run> missing project(s) from the list?</Run>
                        </TextBlock>
                        <TextBlock Text="No files will be deleted from disk."
                                   Foreground="#888" FontSize="12"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Orientation="Horizontal"
                                Spacing="8" HorizontalAlignment="Right"
                                VerticalAlignment="Bottom">
                        <Button Content="Cancel"
                                Command="{Binding CancelRemoveMissingCommand}"
                                Width="80" Height="32"/>
                        <Button Content="Clear All"
                                Command="{Binding ConfirmRemoveMissingCommand}"
                                Width="80" Height="32"
                                Background="#CC4444" Foreground="White"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>

    </Grid>
</UserControl>
