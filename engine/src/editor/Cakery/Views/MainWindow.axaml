<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Cakery.ViewModels"
        xmlns:views="using:Cakery.Views"
        xmlns:controls="using:Cakery.Controls"
        x:Class="Cakery.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding Title}" Width="1600" Height="900" MinWidth="800" MinHeight="600">

    <Design.DataContext>
        <vm:MainViewModel/>
    </Design.DataContext>

    <Panel>
        <!-- Startup: Project Manager -->
        <Panel IsVisible="{Binding !WorkspaceActive}">
            <views:ProjectManagerView DataContext="{Binding ProjectManager}"/>
        </Panel>

        <!-- Workspace: Editor -->
        <Grid IsVisible="{Binding WorkspaceActive}" RowDefinitions="Auto,Auto,*,Auto">
            <Menu Grid.Row="0">
                <MenuItem Header="_File">
                    <MenuItem Header="_New Scene"/><MenuItem Header="_Open Project..."/>
                    <MenuItem Header="_Save"/><Separator/><MenuItem Header="E_xit"/>
                </MenuItem>
                <MenuItem Header="_Edit">
                    <MenuItem Header="_Undo"/><MenuItem Header="_Redo"/>
                </MenuItem>
            </Menu>

            <Border Grid.Row="1" Background="#1E1E1E" Padding="4,2" BorderThickness="0,0,0,1" BorderBrush="#333">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button Content="▶" ToolTip.Tip="Play" Command="{Binding PlayCommand}" Width="32" Height="24"/>
                    <Button Content="⏸" ToolTip.Tip="Pause" Command="{Binding PauseCommand}" Width="32" Height="24"/>
                    <Button Content="⏹" ToolTip.Tip="Stop" Command="{Binding StopCommand}" Width="32" Height="24"/>
                    <Separator Width="8"/>
                    <TextBlock Text="{Binding FpsDisplay}" Foreground="Gray" VerticalAlignment="Center" FontSize="12"/>
                    <TextBlock Text="{Binding StatusText}" Foreground="#888" VerticalAlignment="Center" FontSize="12" Margin="8,0,0,0"/>
                </StackPanel>
            </Border>

            <Grid Grid.Row="2" ColumnDefinitions="280,*,320">
                <Grid Grid.Column="0" RowDefinitions="*,*">
                    <Border Grid.Row="0" BorderThickness="0,0,1,1" BorderBrush="#333"><views:HierarchyView/></Border>
                    <Border Grid.Row="1" BorderThickness="0,0,1,0" BorderBrush="#333"><views:ProjectView/></Border>
                </Grid>
                <Border Grid.Column="1" BorderThickness="0,0,1,0" BorderBrush="#333"><controls:ViewportControl/></Border>
                <Grid Grid.Column="2" RowDefinitions="*,*">
                    <Border Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="#333"><views:InspectorView/></Border>
                    <Border Grid.Row="1"><views:ConsoleView/></Border>
                </Grid>
            </Grid>

            <Border Grid.Row="3" BorderThickness="0,1,0,0" BorderBrush="#333" Padding="4,2">
                <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="Gray"/>
            </Border>
        </Grid>
    </Panel>
</Window>
