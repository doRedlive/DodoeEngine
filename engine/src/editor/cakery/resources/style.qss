/* Cakery Editor — Dracula Dark Theme (from ui.xml) */

QMainWindow {
    background-color: #191A21;
    /* Ensure native window frame is visible for resize */
    padding: 0px;
    margin: 0px;
}

QMainWindow::separator {
    background-color: #44475A;
    width: 4px;
    height: 4px;
}

/* ---- Menu Bar ---- */
QMenuBar {
    background-color: #191A21;
    color: #F8F8F2;
    padding: 3px 4px;
    border: none;
}

QMenuBar::item {
    background: transparent;
    padding: 4px 9px;
    border-radius: 5px;
}

QMenuBar::item:selected {
    background-color: #44475A;
}

QMenu {
    background-color: #282A36;
    border: 1px solid #191A21;
    border-radius: 8px;
    padding: 4px;
}

QMenu::item {
    padding: 5px 24px 5px 20px;
    border-radius: 5px;
}

QMenu::item:selected {
    background-color: #BC92F9;
    color: #191A21;
}

QMenu::separator {
    height: 1px;
    background: #44475A;
    margin: 4px 6px;
}

/* ---- Tool Bar ---- */
QToolBar {
    background-color: #1E1E1E;
    border: none;
    spacing: 4px;
    padding: 2px 4px;
}

QToolBar#mainToolBar {
    background-color: #282A36;
    border: none;
    border-radius: 10px;
    margin: 0px;
}

QToolButton {
    background-color: transparent;
    color: #F8F8F2;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 4px 7px;
}

QToolButton:hover {
    background-color: #44475A;
    border: 1px solid #191A21;
}

QToolButton:pressed {
    background-color: #21222C;
}

QToolButton:checked {
    background-color: #44475A;
    border: 1px solid #BC92F9;
    color: #BC92F9;
}

/* ---- Push Button ---- */
QPushButton {
    background-color: #44475A;
    color: #F8F8F2;
    border: 1px solid #191A21;
    border-radius: 6px;
    padding: 5px 12px;
}

QPushButton:hover {
    background-color: #565A73;
}

QPushButton:pressed {
    background-color: #BC92F9;
    color: #191A21;
}

/* ---- Dock Widget ---- */
QDockWidget {
    background-color: #191A21;
    color: #BC92F9;
    font-weight: bold;
    titlebar-close-icon: none;
    titlebar-normal-icon: none;
}

QDockWidget::title {
    background-color: #282A36;
    color: #BC92F9;
    padding: 5px 10px;
    margin: 0px;
    border: none;
    border-top-left-radius: 0px;
    border-top-right-radius: 0px;
    text-align: left;
    min-height: 26px;
}

QDockWidget::close-button,
QDockWidget::float-button {
    background: transparent;
    border: none;
    border-radius: 4px;
    padding: 2px;
    min-width: 18px;
    min-height: 18px;
}

QDockWidget::close-button:hover,
QDockWidget::float-button:hover {
    background-color: #44475A;
}

QDockWidget::close-button:pressed {
    background-color: #FF5555;
}

QMainWindow::tab-bar {
    background-color: #21222C;
    border: none;
    alignment: left;
}

QTabBar::tab {
    background-color: #21222C;
    color: #6272A4;
    padding: 5px 14px;
    border: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    margin-right: 2px;
    min-height: 24px;
}

QTabBar::tab:hover {
    color: #F8F8F2;
    background-color: #343746;
}

QTabBar::tab:selected {
    background-color: #282A36;
    color: #FF79C6;
}

QTabBar::close-button {
    background: transparent;
    border: none;
    border-radius: 3px;
    image: none;
}

QTabBar::close-button:hover {
    background-color: #FF5555;
}

/* ---- Tree / List / Table ---- */
QTreeWidget, QListWidget, QTableWidget, QTreeView, QListView {
    background-color: transparent;
    alternate-background-color: #2C2E3B;
    border: none;
    outline: none;
    color: #F8F8F2;
}

QTreeWidget::item, QListWidget::item {
    padding: 3px 0px;
    border: none;
}

QTreeWidget::item:selected, QListWidget::item:selected,
QTableWidget::item:selected {
    background-color: #BC92F9;
    color: #191A21;
}

QTreeWidget::item:selected:!active, QListWidget::item:selected:!active,
QTableWidget::item:selected:!active {
    background-color: #44475A;
    color: #F8F8F2;
}

QTreeWidget::item:hover, QListWidget::item:hover {
    background-color: #2C2E3B;
}

QHeaderView::section {
    background-color: #282A36;
    color: #6272A4;
    padding: 4px 6px;
    border: none;
    border-right: 1px solid #191A21;
}

/* ---- Scroll Area ---- */
QScrollArea {
    background-color: transparent;
    border: none;
}

/* ---- Tab Widget ---- */
QTabWidget::pane {
    border: none;
    background-color: #282A36;
    border-radius: 10px;
    top: -1px;
}

QTabBar::tab {
    background-color: #21222C;
    color: #6272A4;
    padding: 6px 16px;
    border: none;
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    margin-right: 3px;
}

QTabBar::tab:hover {
    color: #F8F8F2;
}

QTabBar::tab:selected {
    background-color: #282A36;
    color: #FF79C6;
}

/* ---- Input Widgets ---- */
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background-color: #21222C;
    color: #F8F8F2;
    border: 1px solid #191A21;
    border-radius: 5px;
    padding: 3px 6px;
    selection-background-color: #BC92F9;
    selection-color: #191A21;
}

QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
    border: 1px solid #BC92F9;
}

QComboBox::drop-down {
    border: none;
    width: 18px;
}

QComboBox QAbstractItemView {
    background-color: #343746;
    border: 1px solid #191A21;
    selection-background-color: #BC92F9;
    selection-color: #191A21;
    outline: none;
}

QDoubleSpinBox, QSpinBox {
    min-width: 24px;
}

QDoubleSpinBox::up-button, QDoubleSpinBox::down-button,
QSpinBox::up-button, QSpinBox::down-button {
    width: 0px;
    height: 0px;
    border: none;
}

/* ---- Group Box (Component sections) ---- */
QGroupBox {
    background-color: #343746;
    border: none;
    border-radius: 8px;
    margin-top: 8px;
    padding: 8px 6px 6px 6px;
    font-weight: bold;
    color: #FF79C6;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 0px;
    right: 0px;
    padding: 5px 10px;
    color: #FF79C6;
    background-color: #44475A;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
}

/* ---- Scroll Bars ---- */
QScrollBar:vertical {
    background: transparent;
    width: 13px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #44475A;
    border-radius: 4px;
    min-height: 24px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background: #BC92F9;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }

QScrollBar:horizontal {
    background: transparent;
    height: 13px;
}

QScrollBar::handle:horizontal {
    background: #44475A;
    border-radius: 4px;
    min-width: 24px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover {
    background: #BC92F9;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }

/* ---- Slider ---- */
QSlider::groove:horizontal {
    background: #21222C;
    height: 4px;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background: #6272A4;
    width: 10px;
    margin: -4px 0;
    border-radius: 5px;
}

QSlider::handle:horizontal:hover {
    background: #BC92F9;
}

/* ---- Checkbox ---- */
QCheckBox {
    color: #F8F8F2;
    spacing: 5px;
}

QCheckBox::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid #44475A;
    border-radius: 3px;
    background-color: #21222C;
}

QCheckBox::indicator:checked {
    background-color: #BC92F9;
    border-color: #BC92F9;
}

/* ---- Label ---- */
QLabel {
    color: #F8F8F2;
}

/* ---- Status Bar ---- */
QStatusBar {
    background-color: #191A21;
    color: #6272A4;
    border-top: 1px solid #282A36;
}

/* ---- Splitter ---- */
QSplitter::handle {
    background-color: #44475A;
    width: 4px;
    height: 4px;
}

QSplitter::handle:hover {
    background-color: #BC92F9;
}

/* ---- ADS Dock Manager (Unity Dark) ---- */
ads--CDockContainerWidget {
    background-color: #2D2D2D;
}

ads--CDockAreaWidget {
    background-color: #2D2D2D;
}

ads--CDockAreaTabBar {
    background-color: #252525;
    border: none;
    padding: 2px 2px 0px 2px;
    qproperty-drawBase: false;
}

ads--CDockAreaTitleBar {
    background-color: #2D2D2D;
    padding: 0px 4px;
    border: none;
    min-height: 22px;
    max-height: 22px;
}

ads--CDockWidgetTab {
    background-color: #252525;
    color: #8C8C8C;
    padding: 4px 10px;
    border: none;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    margin-right: 1px;
    font-size: 11px;
    font-weight: normal;
    min-width: 0px;
}

ads--CDockWidgetTab[activeTab="true"] {
    background-color: #383838;
    color: #C4C4C4;
}

ads--CDockWidgetTab:hover:!activeTab {
    color: #C4C4C4;
    background-color: #303030;
}

ads--CDockSplitter {
    background-color: #2D2D2D;
}

ads--CDockSplitter::handle {
    background-color: #1A1A1A;
    width: 1px;
}

ads--CDockSplitter::handle:hover {
    background-color: #2D7DFF;
}

ads--CFloatingDockContainer {
    background-color: #2D2D2D;
}

#tabCloseButton {
    background: transparent;
    border: none;
    border-radius: 3px;
    min-width: 14px;
    min-height: 14px;
    padding: 0px;
}

#tabCloseButton:hover {
    background-color: #FF5A5A;
}
