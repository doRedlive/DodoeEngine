{
  "version": 1,
  "theme": "unity-dark",
  "defaultLayout": "default",
  "shortcuts": {
    "edit.undo": "Ctrl+Z",
    "edit.redo": "Ctrl+Y",
    "scene.new": "Ctrl+N",
    "scene.save": "Ctrl+S",
    "tool.move": "W",
    "tool.rotate": "E",
    "tool.scale": "R",
    "tool.hand": "Q",
    "edit.duplicate": "Ctrl+D",
    "edit.delete": "Del"
  },
  "editor": {
    "gridSnap": true,
    "gridSize": 0.25,
    "showGizmos": true,
    "autoSaveIntervalSec": 0
  }
}
