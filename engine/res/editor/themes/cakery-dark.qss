/* Cakery editor: dense, planar desktop tooling inspired by modern game editors. */

* {
    font-family: "Segoe UI", "Microsoft YaHei UI", sans-serif;
    font-size: 12px;
}

QWidget {
    background: #242424;
    color: #d8d8d8;
}

QMainWindow {
    background: #151515;
}

QMainWindow::separator {
    background: #1f1f1f;
    width: 1px;
    height: 1px;
}

QMenuBar {
    background: #151515;
    color: #c8c8c8;
    padding: 0 5px;
    border: none;
    border-bottom: 1px solid #1f1f1f;
}

QMenuBar::item {
    background: transparent;
    padding: 5px 8px;
    border: none;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background: #2c2c2c;
    color: #E8E8E8;
}

QMenu {
    background: #242424;
    color: #d8d8d8;
    border: 1px solid #1f1f1f;
    border-radius: 6px;
    padding: 4px;
}

QMenu::item {
    min-height: 20px;
    padding: 4px 24px 4px 14px;
    border-radius: 4px;
}

QMenu::item:selected {
    background: #323232;
    color: #E8E8E8;
}

QMenu::separator {
    height: 1px;
    background: #1f1f1f;
    margin: 4px 6px;
}

QToolBar {
    background: #151515;
    border: none;
    border-bottom: 1px solid #1f1f1f;
    spacing: 1px;
    padding: 3px 0;
    min-height: 30px;
}

#editorTitleBar {
    background: #151515;
    border: none;
    border-bottom: 1px solid #1f1f1f;
    min-height: 32px;
    max-height: 32px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
}

#editorTitleBar QLabel#editorWindowTitle {
    background: transparent;
    color: #d8d8d8;
    font-size: 12px;
    font-weight: 600;
    padding: 0 6px;
}

#editorTitleBar QMenuBar {
    background: transparent;
    border: none;
    padding: 0;
}

QToolBar#editorToolbar {
    background: #242424;
    border: none;
    spacing: 8px;
    padding: 4px 10px;
    min-height: 30px;
}

#editorToolbar QLabel#editorBrand {
    color: #E8E8E8;
    font-weight: 700;
    font-size: 13px;
    padding: 0 16px 0 16px;
}

QToolBar::separator {
    background: #1f1f1f;
    width: 1px;
    margin: 3px 7px;
}

QToolBar QLabel {
    color: #c8c8c8;
    font-size: 12px;
    font-weight: 600;
    padding: 0 7px 0 3px;
}

#editorToolbar QToolButton#runtimeToolButton {
    border: none;
    border-radius: 6px;
    min-width: 28px;
    max-width: 28px;
    min-height: 24px;
    padding: 0;
    background: transparent;
    color: #c8c8c8;
}

#editorToolbar QToolButton#runtimeToolButton[runtimeCommand="play"] { color: #50fa7b; }
#editorToolbar QToolButton#runtimeToolButton[runtimeCommand="pause"] { color: #f1fa8c; }
#editorToolbar QToolButton#runtimeToolButton[runtimeCommand="stop"] { color: #ff79c6; }

#editorToolbar QToolButton#runtimeToolButton:hover {
    background: #2c2c2c;
    color: #E8E8E8;
}

#editorToolbar QToolButton#runtimeToolButton:pressed {
    background: #383838;
    color: #E8E8E8;
}

#editorToolbar QToolButton#runtimeToolButton:checked {
    background: #4c83b8;
    color: #ffffff;
}

#editorToolbar QToolButton#runtimeToolButton:disabled {
    color: #555555;
}

QToolBar#sceneToolbar {
    background: #2a2a2a;
    border: none;
    border-bottom: 1px solid #1f1f1f;
    spacing: 1px;
    padding: 2px 4px;
    min-height: 26px;
}

QToolBar#sceneToolbar QToolButton {
    min-width: 27px;
    max-width: 27px;
    min-height: 21px;
    padding: 1px 4px;
}

QToolBar#sceneToolbar QToolButton[sceneTool="translate"] { color: #50fa7b; }
QToolBar#sceneToolbar QToolButton[sceneTool="rotate"] { color: #f1fa8c; }
QToolBar#sceneToolbar QToolButton[sceneTool="scale"] { color: #8be9fd; }

QToolBar#tilePaletteToolbar {
    background: #2a2a2a;
    border: none;
    border-bottom: 1px solid #1f1f1f;
    spacing: 1px;
    padding: 2px 4px;
    min-height: 28px;
}

QToolBar#tilePaletteToolbar QToolButton {
    min-width: 27px;
    max-width: 27px;
    min-height: 22px;
    padding: 1px 4px;
}

QComboBox#tilePaletteTarget {
    min-height: 26px;
}

QLabel#tilePaletteBrushInspector {
    color: #a0a0a0;
    padding: 2px 4px;
}

#windowMinButton,
#windowMaxButton,
#windowCloseButton {
    border: none;
    border-radius: 0;
    min-width: 44px;
    max-width: 44px;
    min-height: 30px;
    padding: 0;
    background: transparent;
    color: #c8c8c8;
    font-size: 13px;
}

#windowMinButton:hover,
#windowMaxButton:hover {
    background: #2c2c2c;
}

#windowCloseButton:hover {
    background: #e81123;
    color: #ffffff;
}

QToolButton {
    background: transparent;
    color: #c8c8c8;
    border: none;
    border-radius: 4px;
    min-height: 22px;
    padding: 1px 8px;
}

QToolButton:hover {
    background: #2c2c2c;
    color: #E8E8E8;
}

QToolButton:pressed {
    background: #383838;
    color: #E8E8E8;
}

QToolButton:checked {
    background: #323232;
    color: #E8E8E8;
}

QPushButton {
    background: #2e2e2e;
    color: #d8d8d8;
    border: 1px solid #1f1f1f;
    border-radius: 4px;
    min-height: 20px;
    padding: 2px 10px;
}

QPushButton:hover {
    background: #383838;
    border-color: #3A3A3A;
}

QPushButton:pressed {
    background: #252525;
    border-color: #151515;
}

QTreeWidget, QListWidget, QTableWidget, QTreeView, QListView {
    background: #242424;
    alternate-background-color: #242424;
    border: none;
    color: #c8c8c8;
    outline: none;
}

QTreeWidget::branch {
    background: transparent;
}

QTreeWidget::branch:selected, QTreeView::branch:selected {
    background: transparent;
}

QTreeWidget::item, QListWidget::item {
    min-height: 20px;
    padding: 2px 6px;
    border: none;
    border-radius: 4px;
    margin: 1px 3px;
}

QTreeWidget::item:hover, QListWidget::item:hover {
    background: #2c2c2c;
}

QTreeWidget::item:selected, QListWidget::item:selected,
QTableWidget::item:selected {
    background: #454545;
    color: #E8E8E8;
    border-radius: 5px;
}

QTreeWidget::item:selected:!active, QListWidget::item:selected:!active,
QTableWidget::item:selected:!active {
    background: #3a3a3a;
    color: #d8d8d8;
}

QHeaderView::section {
    background: #242424;
    color: #a0a0a0;
    padding: 3px 6px;
    border: none;
    border-right: 1px solid #1f1f1f;
    border-bottom: 1px solid #1f1f1f;
}

QScrollArea {
    background: #242424;
    border: none;
}

QWidget#inspectorContent {
    background: #242424;
}

QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background: #2e2e2e;
    color: #d8d8d8;
    border: 1px solid #1f1f1f;
    border-radius: 4px;
    min-height: 19px;
    padding: 1px 6px;
    selection-background-color: #4c83b8;
    selection-color: #ffffff;
}

QLineEdit:hover, QSpinBox:hover, QDoubleSpinBox:hover, QComboBox:hover {
    border-color: #3A3A3A;
}

QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
    border-color: #4c83b8;
}

QComboBox::drop-down {
    border: none;
    width: 18px;
}

QComboBox QAbstractItemView {
    background: #242424;
    border: 1px solid #1f1f1f;
    border-radius: 5px;
    selection-background-color: #323232;
    selection-color: #E8E8E8;
    outline: none;
    padding: 4px;
}

QDoubleSpinBox, QSpinBox {
    min-width: 64px;
}

QDoubleSpinBox::up-button, QDoubleSpinBox::down-button,
QSpinBox::up-button, QSpinBox::down-button {
    width: 0;
    height: 0;
    border: none;
}

QGroupBox {
    background: #2a2a2a;
    color: #c8c8c8;
    border: none;
    border-radius: 4px;
    margin-top: 12px;
    padding: 6px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 6px;
    right: 0;
    height: 14px;
    padding: 0 3px;
    color: #a0a0a0;
    background: transparent;
}

QGroupBox#inspectorNestedGroup {
    background: transparent;
    border: none;
    border-radius: 0;
    margin-top: 4px;
    padding: 2px 4px;
}

QGroupBox#inspectorNestedGroup::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 4px;
    height: 14px;
    padding: 0 2px;
    background: transparent;
    color: #8a8a8a;
    font-size: 12px;
    font-weight: 600;
}

QLabel#inspectorFieldLabel {
    color: #A8A8A8;
    padding-left: 2px;
}

QToolButton#inspectorAssetReference {
    background: #1f1f1f;
    border: 1px solid #151515;
    border-radius: 3px;
    color: #d0d0d0;
    padding: 2px 6px;
    text-align: left;
}

QToolButton#inspectorAssetReference:hover {
    border-color: #4c83b8;
    background: #292929;
}

QToolButton#inspectorAssetReferenceClear {
    background: #1f1f1f;
    border: 1px solid #151515;
    border-radius: 3px;
    color: #a8a8a8;
}

QToolButton#inspectorAssetReferenceClear:hover {
    background: #3a2b2b;
    color: #f0b0b0;
}

QFrame#inspectorAssetPicker {
    background: #252525;
    border: 1px solid #3a3a3a;
    border-radius: 4px;
}

QFrame#inspectorAssetPicker QLineEdit {
    background: #1f1f1f;
    border: 1px solid #151515;
    border-radius: 3px;
    min-height: 26px;
}

QFrame#inspectorAssetPicker QListWidget {
    background: #202020;
    border: none;
    padding: 2px;
}

QFrame#inspectorAssetPicker QListWidget::item {
    border-radius: 3px;
    padding: 3px;
}

QFrame#inspectorAssetPicker QListWidget::item:hover {
    background: #323232;
}

QFrame#inspectorAssetPicker QListWidget::item:selected {
    background: #3a5670;
}

QLabel#inspectorAssetName {
    color: #e5e5e5;
    font-size: 15px;
    font-weight: 600;
}

QLabel#inspectorAssetPreview {
    background: #1f1f1f;
    border: 1px solid #151515;
    border-radius: 4px;
    min-height: 120px;
}

QListWidget#projectAssetGrid {
    background: #202020;
    border: none;
    padding: 6px;
}

QListWidget#projectAssetGrid::item {
    border-radius: 4px;
    padding: 4px;
}

QListWidget#projectAssetGrid::item:hover {
    background: #323232;
}

QListWidget#projectAssetGrid::item:selected {
    background: #3a5670;
    color: #f0f0f0;
}

QLineEdit#inspectorObjectName {
    min-height: 32px;
    font-size: 15px;
    font-weight: 600;
    color: #E5E5E5;
    background: transparent;
    border: none;
}

QWidget#inspectorSelectionBar {
    background: #2e2e2e;
    border: 1px solid #1f1f1f;
    border-radius: 6px;
    min-height: 40px;
}

QToolButton#inspectorObjectMenu {
    background: transparent;
    border: none;
    border-radius: 4px;
    min-width: 26px;
    max-width: 26px;
    min-height: 26px;
    color: #a0a0a0;
}

QToolButton#inspectorObjectMenu:hover {
    background: #3a3a3a;
    color: #E8E8E8;
}

QLineEdit#inspectorFilter {
    min-height: 22px;
    background: #2a2a2a;
    border: 1px solid #1f1f1f;
    border-radius: 5px;
    color: #b0b0b0;
}

QLineEdit#inspectorFilter:focus {
    border-color: #4c83b8;
}

QWidget#inspectorSection {
    background: transparent;
    border: none;
    border-radius: 0;
    margin: 0;
    padding: 0;
}

QWidget#inspectorSectionHeaderRow {
    background: #2a2a2a;
    border: none;
    border-radius: 4px;
    min-height: 22px;
}

QPushButton#inspectorSectionHeader {
    min-height: 22px;
    background: transparent;
    color: #D0D0D0;
    border: none;
    border-radius: 4px;
    padding: 0 8px;
    text-align: left;
    font-weight: 600;
}

QPushButton#inspectorSectionHeader:hover {
    background: #323232;
    color: #E8E8E8;
}

QPushButton#inspectorSectionHeader:checked {
    background: transparent;
    color: #D0D0D0;
    border: none;
}

QToolButton#inspectorSectionMenu {
    background: transparent;
    border: none;
    border-radius: 4px;
    min-width: 24px;
    max-width: 24px;
    min-height: 24px;
    color: #8a8a8a;
}

QToolButton#inspectorSectionMenu:hover {
    background: #3a3a3a;
    color: #E8E8E8;
}

QWidget#inspectorSectionBody {
    background: transparent;
    border: none;
    border-radius: 0;
}

QWidget#inspectorSectionBody QDoubleSpinBox,
QWidget#inspectorSectionBody QSpinBox,
QWidget#inspectorSectionBody QLineEdit {
    background: #1f1f1f;
    border: 1px solid #151515;
    border-radius: 3px;
    min-height: 26px;
}

QWidget#inspectorSectionBody QDoubleSpinBox:focus,
QWidget#inspectorSectionBody QSpinBox:focus,
QWidget#inspectorSectionBody QLineEdit:focus {
    border-color: #4c83b8;
}

QWidget#inspectorVector {
    background: transparent;
    border: none;
}

QWidget#inspectorVector QDoubleSpinBox,
QWidget#inspectorVector QSpinBox {
    min-width: 0;
}

QWidget#inspectorBoolField {
    background: #1f1f1f;
    border: 1px solid #151515;
    border-radius: 4px;
}

QWidget#inspectorColorField {
    background: #1f1f1f;
    border: 1px solid #151515;
    border-radius: 4px;
}

QComboBox#inspectorLayerField, QToolButton#inspectorMaskField {
    background: #1f1f1f;
    border: 1px solid #151515;
    border-radius: 3px;
    min-height: 26px;
    padding: 1px 6px;
}

QLabel#inspectorAxisLabel {
    color: #8a8a8a;
    font-size: 11px;
    font-weight: 600;
    min-width: 10px;
}

QLabel#inspectorAxisLabel[axis="x"] {
    color: #e84d5b;
}

QLabel#inspectorAxisLabel[axis="y"] {
    color: #58b96f;
}

QLabel#inspectorAxisLabel[axis="z"] {
    color: #4d9de0;
}

QLabel#inspectorAxisLabel[axis="w"] {
    color: #b588d8;
}

QPushButton#inspectorAddButton {
    background: #323232;
    border: 1px solid #444444;
    border-radius: 4px;
    min-height: 24px;
    padding: 1px 8px;
    color: #dedede;
    font-weight: 600;
}

QPushButton#inspectorAddButton:hover {
    background: #3a3a3a;
    border-color: #5c5c5c;
    color: #ffffff;
}

QLineEdit#inspectorAddSearch {
    background: #2a2a2a;
    border: 1px solid #1f1f1f;
    border-radius: 4px;
    padding: 3px 6px;
    min-height: 20px;
    color: #b0b0b0;
}

QLineEdit#inspectorAddSearch:focus {
    border-color: #4c83b8;
}

QLineEdit#consoleSearch, QLineEdit#historySearch,
QComboBox#consoleLevelFilter {
    min-height: 24px;
    background: #1f1f1f;
    border: 1px solid #151515;
    border-radius: 3px;
}

QToolButton#consoleToolButton, QToolButton#historyToolButton {
    background: #2e2e2e;
    border: 1px solid #1f1f1f;
    border-radius: 3px;
    min-width: 26px;
    max-width: 26px;
    min-height: 24px;
    padding: 0;
}

QToolButton#consoleToolButton:hover, QToolButton#historyToolButton:hover {
    background: #3a3a3a;
    border-color: #555555;
}

QListWidget#consoleList, QListWidget#historyList {
    background: #1f1f1f;
    border: 1px solid #151515;
    border-radius: 3px;
    padding: 2px;
}

QListWidget#consoleList::item, QListWidget#historyList::item {
    border-radius: 2px;
    margin: 0;
    padding: 3px 6px;
}

QScrollBar:vertical {
    background: #242424;
    width: 8px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #3a3a3a;
    border: none;
    min-height: 28px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background: #555555;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background: #242424;
    height: 8px;
}

QScrollBar::handle:horizontal {
    background: #3a3a3a;
    border: none;
    min-width: 28px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal:hover {
    background: #555555;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical,
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal,
QScrollBar::corner {
    background: #242424;
}

QSlider::groove:horizontal {
    background: #1f1f1f;
    height: 3px;
}

QSlider::handle:horizontal {
    background: #a0a0a0;
    width: 9px;
    margin: -4px 0;
    border-radius: 4px;
}

QSlider::handle:horizontal:hover {
    background: #c6c6c6;
}

QCheckBox {
    color: #d8d8d8;
    spacing: 5px;
}

QCheckBox::indicator {
    width: 13px;
    height: 13px;
    border: 1px solid #3A3A3A;
    border-radius: 3px;
    background: #2e2e2e;
}

QCheckBox::indicator:checked {
    background: #4c83b8;
    border-color: #3a6a9a;
}

QLabel {
    color: #d8d8d8;
}

QStatusBar {
    background: #151515;
    color: #a0a0a0;
    border-top: 1px solid #1f1f1f;
}

QSplitter, ads--CDockSplitter {
    qproperty-handleWidth: 1;
}

QSplitter::handle:horizontal,
ads--CDockSplitter::handle:horizontal {
    background: #151515;
    width: 1px;
}

QSplitter::handle:vertical,
ads--CDockSplitter::handle:vertical {
    background: #151515;
    height: 1px;
}

QSplitter::handle:hover,
ads--CDockSplitter::handle:hover {
    background: #4c83b8;
}

ads--CDockContainerWidget,
ads--CDockSplitter,
ads--CFloatingDockContainer {
    background: #151515;
    border: 1px solid #1f1f1f;
    border-radius: 8px;
    margin: 0;
    padding: 0;
}

ads--CFloatingDockContainer ads--CDockContainerWidget {
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

ads--CDockAreaWidget {
    background: #151515;
    border: none;
    margin: 2px;
    padding: 0;
}

ads--CDockManager {
    background: #151515;
}

ads--CDockWidget {
    background: #242424;
    border: 1px solid #1f1f1f;
    border-top: none;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    margin: 0;
    padding: 0;
}

ads--CDockWidget QScrollArea#dockWidgetScrollArea {
    padding: 0;
    border: none;
    background: #242424;
}

ads--CDockAreaTabBar {
    background: #242424;
    border: none;
    padding: 0;
    qproperty-drawBase: false;
}

ads--CDockAreaTitleBar {
    background: #242424;
    padding: 3px 4px 2px;
    border: 1px solid #1f1f1f;
    min-height: 30px;
    max-height: 30px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
}

ads--CDockWidgetTab {
    background: transparent;
    color: #a0a0a0;
    padding: 5px 10px 4px;
    border: none;
    margin: 2px 1px;
    font-size: 12px;
    font-weight: normal;
    min-width: 50px;
    border-radius: 5px;
}

ads--CDockWidgetTab[activeTab="true"] {
    background: #323232;
    color: #E8E8E8;
    border-radius: 5px;
}

ads--CDockWidgetTab QLabel {
    background: transparent;
    color: #a0a0a0;
}

ads--CDockWidgetTab[activeTab="true"] QLabel {
    color: #E8E8E8;
}

ads--CDockWidgetTab:hover:!activeTab {
    background: #2c2c2c;
    color: #d8d8d8;
}

ads--CTitleBarButton {
    background: transparent;
    border: none;
    padding: 2px;
    min-width: 22px;
    min-height: 22px;
    border-radius: 4px;
}

ads--CTitleBarButton:hover {
    background: #323232;
}

/* Leave the Auto Hide command in the title context menu, but do not show a
   permanent pin button in every dock title bar. */
ads--CDockAreaTitleBar ads--CTitleBarButton {
    min-width: 0;
    max-width: 0;
    min-height: 0;
    max-height: 0;
    padding: 0;
    margin: 0;
}

ads--CAutoHideSideBar {
    background: #151515;
    border: none;
}

ads--CAutoHideTab {
    background: #242424;
    color: #a0a0a0;
    border: 1px solid #1f1f1f;
    border-radius: 8px;
    padding: 6px 10px;
    margin: 2px;
}

ads--CAutoHideTab:hover,
ads--CAutoHideTab[activeTab="true"] {
    background: #323232;
    color: #d8d8d8;
    border-color: #3a3a3a;
}

ads--CAutoHideDockContainer {
    background: #242424;
    border: 1px solid #3a3a3a;
    border-radius: 6px;
    margin: 0;
}

ads--CAutoHideDockContainer #autoHideDockArea {
    background: #242424;
    margin: 0;
    padding: 0;
}

ads--CAutoHideDockContainer ads--CDockAreaTitleBar {
    background: #242424;
    border: none;
    border-bottom: 1px solid #1f1f1f;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
}

ads--CAutoHideDockContainer ads--CDockWidget {
    background: #242424;
    border: none;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
}

ads--CAutoHideDockContainer ads--CResizeHandle {
    background: transparent;
    border: none;
}

/* Keeps the already-built preview free of visible close glyphs as well. */
#tabCloseButton,
#dockAreaCloseButton {
    qproperty-icon: none;
    min-width: 0;
    max-width: 0;
    min-height: 0;
    max-height: 0;
    margin: 0;
    padding: 0;
    border: none;
}

QDialog#ProjectManagerWindow {
    background: #151515;
}

QDialog#unsavedChangesDialog {
    background: #242424;
    border: 1px solid #454545;
    border-radius: 10px;
}

QMessageBox {
    background: #242424;
    border: 1px solid #454545;
    border-radius: 10px;
}

QMessageBox QLabel {
    color: #d8d8d8;
}

QDialog#unsavedChangesDialog QWidget#unsavedChangesBody {
    background: #242424;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
}

QLabel#unsavedChangesMessage {
    color: #d8d8d8;
    font-size: 13px;
}

QLabel#projectManagerTitle {
    color: #E8E8E8;
    font-size: 20px;
    font-weight: 700;
}

QListWidget#projectList {
    background: #242424;
    border: 1px solid #1f1f1f;
    border-radius: 6px;
    margin: 8px;
    padding: 4px;
}

QWidget#projectDetailPanel {
    background: #242424;
    border: 1px solid #1f1f1f;
    border-radius: 6px;
    margin: 8px;
}

QLabel#projectDetailName {
    color: #E8E8E8;
    font-size: 18px;
    font-weight: 600;
}

QLabel#projectDetailDescription {
    color: #a0a0a0;
}

QLabel#projectDetailPath,
QLabel#projectDetailDate {
    color: #a0a0a0;
}

QPushButton#projectPrimaryButton {
    background: #2e2e2e;
    border: 1px solid #1f1f1f;
    border-radius: 4px;
    color: #E8E8E8;
}

QPushButton#projectPrimaryButton:hover {
    background: #383838;
    border-color: #3A3A3A;
}

QPushButton#projectPrimaryButton:pressed {
    background: #252525;
}

QPushButton#projectFlatButton {
    background: transparent;
    border: none;
    color: #a0a0a0;
}

QPushButton#projectFlatButton:hover {
    color: #E8E8E8;
    background: #2c2c2c;
}
