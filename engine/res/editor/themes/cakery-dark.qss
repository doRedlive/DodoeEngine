/* Cakery editor: dense, planar desktop tooling inspired by modern game editors. */

* {
    font-family: "Segoe UI", "Microsoft YaHei UI", sans-serif;
    font-size: 12px;
}

QWidget {
    background: #242424;
    color: #d8d8d8;
}

QMainWindow {
    background: #151515;
}

QMainWindow::separator {
    background: #1f1f1f;
    width: 1px;
    height: 1px;
}

QMenuBar {
    background: #151515;
    color: #c8c8c8;
    padding: 0 5px;
    border: none;
    border-bottom: 1px solid #1f1f1f;
}

QMenuBar::item {
    background: transparent;
    padding: 5px 8px;
    border: none;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background: #2c2c2c;
    color: #E8E8E8;
}

QMenu {
    background: #242424;
    color: #d8d8d8;
    border: 1px solid #1f1f1f;
    border-radius: 6px;
    padding: 4px;
}

QMenu::item {
    min-height: 20px;
    padding: 4px 24px 4px 14px;
    border-radius: 4px;
}

QMenu::item:selected {
    background: #323232;
    color: #E8E8E8;
}

QMenu::separator {
    height: 1px;
    background: #1f1f1f;
    margin: 4px 6px;
}

QToolBar {
    background: #151515;
    border: none;
    border-bottom: 1px solid #1f1f1f;
    spacing: 1px;
    padding: 3px 0;
    min-height: 30px;
}

#editorTitleBar {
    background: #151515;
    border: none;
    border-bottom: 1px solid #1f1f1f;
    min-height: 32px;
    max-height: 32px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
}

#editorTitleBar QLabel#editorWindowTitle {
    background: transparent;
    color: #d8d8d8;
    font-size: 12px;
    font-weight: 600;
    padding: 0 6px;
}

#editorTitleBar QMenuBar {
    background: transparent;
    border: none;
    padding: 0;
}

QToolBar#editorToolbar {
    background: #242424;
    border: none;
    spacing: 8px;
    padding: 4px 10px;
    min-height: 30px;
}

#editorToolbar QLabel#editorBrand {
    color: #E8E8E8;
    font-weight: 700;
    font-size: 13px;
    padding: 0 16px 0 16px;
}

QToolBar::separator {
    background: #1f1f1f;
    width: 1px;
    margin: 3px 7px;
}

QToolBar QLabel {
    color: #c8c8c8;
    font-size: 12px;
    font-weight: 600;
    padding: 0 7px 0 3px;
}

#editorToolbar QToolButton#runtimeToolButton {
    border: none;
    border-radius: 6px;
    min-width: 28px;
    max-width: 28px;
    min-height: 24px;
    padding: 0;
    background: transparent;
    color: #c8c8c8;
}

#editorToolbar QToolButton#runtimeToolButton[runtimeCommand="play"] { color: #50fa7b; }
#editorToolbar QToolButton#runtimeToolButton[runtimeCommand="pause"] { color: #f1fa8c; }
#editorToolbar QToolButton#runtimeToolButton[runtimeCommand="stop"] { color: #ff79c6; }

#editorToolbar QToolButton#runtimeToolButton:hover {
    background: #2c2c2c;
    color: #E8E8E8;
}

#editorToolbar QToolButton#runtimeToolButton:pressed {
    background: #383838;
    color: #E8E8E8;
}

#editorToolbar QToolButton#runtimeToolButton:checked {
    background: #bd93f9;
    color: #ffffff;
}

#editorToolbar QToolButton#runtimeToolButton:disabled {
    color: #555555;
}

QToolBar#sceneToolbar {
    background: #2a2a2a;
    border: none;
    border-bottom: 1px solid #1f1f1f;
    spacing: 1px;
    padding: 2px 4px;
    min-height: 26px;
}

QToolBar#sceneToolbar QToolButton {
    min-width: 27px;
    max-width: 27px;
    min-height: 21px;
    padding: 1px 4px;
}

QToolBar#sceneToolbar QToolButton[sceneTool="translate"] { color: #50fa7b; }
QToolBar#sceneToolbar QToolButton[sceneTool="rotate"] { color: #f1fa8c; }
QToolBar#sceneToolbar QToolButton[sceneTool="scale"] { color: #8be9fd; }

QToolBar#tilePaletteToolbar {
    background: #2a2a2a;
    border: none;
    border-bottom: 1px solid #1f1f1f;
    spacing: 1px;
    padding: 2px 4px;
    min-height: 28px;
}

QToolBar#tilePaletteToolbar QToolButton {
    min-width: 27px;
    max-width: 27px;
    min-height: 22px;
    padding: 1px 4px;
}

QComboBox#tilePaletteTarget {
    min-height: 26px;
}

QLabel#tilePaletteBrushInspector {
    color: #a0a0a0;
    padding: 2px 4px;
}

#windowMinButton,
#windowMaxButton,
#windowCloseButton {
    border: none;
    border-radius: 0;
    min-width: 44px;
    max-width: 44px;
    min-height: 30px;
    padding: 0;
    background: transparent;
    color: #c8c8c8;
    font-size: 13px;
}

#windowMinButton:hover,
#windowMaxButton:hover {
    background: #2c2c2c;
}

#windowCloseButton:hover {
    background: #e81123;
    color: #ffffff;
}

QToolButton {
    background: transparent;
    color: #c8c8c8;
    border: none;
    border-radius: 4px;
    min-height: 22px;
    padding: 1px 8px;
}

QToolButton:hover {
    background: #2c2c2c;
    color: #E8E8E8;
}

QToolButton:pressed {
    background: #383838;
    color: #E8E8E8;
}

QToolButton:checked {
    background: #323232;
    color: #E8E8E8;
}

QPushButton {
    background: #2e2e2e;
    color: #d8d8d8;
    border: 1px solid #1f1f1f;
    border-radius: 4px;
    min-height: 20px;
    padding: 2px 10px;
}

QPushButton:hover {
    background: #383838;
    border-color: #3A3A3A;
}

QPushButton:pressed {
    background: #252525;
    border-color: #151515;
}

QTreeWidget, QListWidget, QTableWidget, QTreeView, QListView {
    background: #242424;
    alternate-background-color: #242424;
    border: none;
    color: #c8c8c8;
    outline: none;
}

QTreeWidget::branch {
    background: transparent;
}

QTreeWidget::branch:selected, QTreeView::branch:selected {
    background: transparent;
}

QTreeWidget::item, QListWidget::item {
    min-height: 20px;
    padding: 2px 6px;
    border: none;
    border-radius: 4px;
    margin: 1px 3px;
}

QTreeWidget::item:hover, QListWidget::item:hover {
    background: #2c2c2c;
}

QTreeWidget::item:selected, QListWidget::item:selected,
QTableWidget::item:selected {
    background: #454545;
    color: #E8E8E8;
    border-radius: 5px;
}

QTreeWidget::item:selected:!active, QListWidget::item:selected:!active,
QTableWidget::item:selected:!active {
    background: #3a3a3a;
    color: #d8d8d8;
}

QHeaderView::section {
    background: #242424;
    color: #a0a0a0;
    padding: 3px 6px;
    border: none;
    border-right: 1px solid #1f1f1f;
    border-bottom: 1px solid #1f1f1f;
}

QScrollArea {
    background: #242424;
    border: none;
}

QWidget#inspectorContent {
    background: #242424;
}

QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background: #2e2e2e;
    color: #d8d8d8;
    border: 1px solid #1f1f1f;
    border-radius: 4px;
    min-height: 19px;
    padding: 1px 6px;
    selection-background-color: #bd93f9;
    selection-color: #ffffff;
}

QLineEdit:hover, QSpinBox:hover, QDoubleSpinBox:hover, QComboBox:hover {
    border-color: #3A3A3A;
}

QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
    border-color: #bd93f9;
}

QComboBox::drop-down {
    border: none;
    width: 18px;
}

QComboBox QAbstractItemView {
    background: #242424;
    border: 1px solid #1f1f1f;
    border-radius: 5px;
    selection-background-color: #bd93f9;
    selection-color: #282a36;
    outline: none;
    padding: 4px;
}

QComboBox QAbstractItemView::item {
    min-height: 22px;
    padding: 3px 8px;
    border-radius: 4px;
    margin: 1px 2px;
}

QComboBox QAbstractItemView::item:selected,
QComboBox QAbstractItemView::item:hover {
    background: #bd93f9;
    color: #282a36;
}

QDoubleSpinBox, QSpinBox {
    min-width: 64px;
}

QDoubleSpinBox::up-button, QDoubleSpinBox::down-button,
QSpinBox::up-button, QSpinBox::down-button {
    width: 0;
    height: 0;
    border: none;
}

QGroupBox {
    background: #2a2a2a;
    color: #c8c8c8;
    border: none;
    border-radius: 4px;
    margin-top: 12px;
    padding: 6px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 6px;
    right: 0;
    height: 14px;
    padding: 0 3px;
    color: #a0a0a0;
    background: transparent;
}

QGroupBox#inspectorNestedGroup {
    background: transparent;
    border: none;
    border-radius: 0;
    margin-top: 4px;
    padding: 2px 4px;
}

QGroupBox#inspectorNestedGroup::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 4px;
    height: 14px;
    padding: 0 2px;
    background: transparent;
    color: #8a8a8a;
    font-size: 12px;
    font-weight: 600;
}

QLabel#inspectorFieldLabel {
    color: #A8A8A8;
    padding-left: 2px;
}

QToolButton#inspectorAssetReference {
    background: #1f1f1f;
    border: 1px solid #151515;
    border-radius: 3px;
    color: #d0d0d0;
    padding: 2px 6px;
    text-align: left;
}

QToolButton#inspectorAssetReference:hover {
    border-color: #bd93f9;
    background: #292929;
}

QToolButton#inspectorAssetReferenceClear {
    background: #1f1f1f;
    border: 1px solid #151515;
    border-radius: 3px;
    color: #a8a8a8;
}

QToolButton#inspectorAssetReferenceClear:hover {
    background: #3a2b2b;
    color: #f0b0b0;
}

QFrame#inspectorAssetPicker {
    background: #252525;
    border: 1px solid #3a3a3a;
    border-radius: 4px;
}

QFrame#inspectorAssetPicker QLineEdit {
    background: #1f1f1f;
    border: 1px solid #151515;
    border-radius: 3px;
    min-height: 26px;
}

QFrame#inspectorAssetPicker QListWidget {
    background: #202020;
    border: none;
    padding: 2px;
}

QFrame#inspectorAssetPicker QListWidget::item {
    border-radius: 3px;
    padding: 3px;
}

QFrame#inspectorAssetPicker QListWidget::item:hover {
    background: #323232;
}

QFrame#inspectorAssetPicker QListWidget::item:selected {
    background: #4e3d69;
}

QLabel#inspectorAssetName {
    color: #e5e5e5;
    font-size: 15px;
    font-weight: 600;
}

QLabel#inspectorAssetPreview {
    background: #1f1f1f;
    border: 1px solid #151515;
    border-radius: 4px;
    min-height: 120px;
}

QListWidget#projectAssetGrid {
    background: #202020;
    border: none;
    padding: 6px;
}

QListWidget#projectAssetGrid::item {
    border-radius: 4px;
    padding: 4px;
}

QListWidget#projectAssetGrid::item:hover {
    background: #323232;
}

QListWidget#projectAssetGrid::item:selected {
    background: #4e3d69;
    color: #f0f0f0;
}

QLineEdit#inspectorObjectName {
    min-height: 32px;
    font-size: 15px;
    font-weight: 600;
    color: #E5E5E5;
    background: transparent;
    border: none;
}

QWidget#inspectorSelectionBar {
    background: #2e2e2e;
    border: 1px solid #1f1f1f;
    border-radius: 6px;
    min-height: 40px;
}

QToolButton#inspectorObjectMenu {
    background: transparent;
    border: none;
    border-radius: 4px;
    min-width: 26px;
    max-width: 26px;
    min-height: 26px;
    color: #a0a0a0;
}

QToolButton#inspectorObjectMenu:hover {
    background: #3a3a3a;
    color: #E8E8E8;
}

QLineEdit#inspectorFilter {
    min-height: 22px;
    background: #2a2a2a;
    border: 1px solid #1f1f1f;
    border-radius: 5px;
    color: #b0b0b0;
}

QLineEdit#inspectorFilter:focus {
    border-color: #bd93f9;
}

QWidget#inspectorSection {
    background: transparent;
    border: none;
    border-radius: 0;
    margin: 0;
    padding: 0;
}

QWidget#inspectorSectionHeaderRow {
    background: #2a2a2a;
    border: none;
    border-radius: 4px;
    min-height: 22px;
}

QPushButton#inspectorSectionHeader {
    min-height: 22px;
    background: transparent;
    color: #D0D0D0;
    border: none;
    border-radius: 4px;
    padding: 0 8px;
    text-align: left;
    font-weight: 600;
}

QPushButton#inspectorSectionHeader:hover {
    background: #323232;
    color: #E8E8E8;
}

QPushButton#inspectorSectionHeader:checked {
    background: transparent;
    color: #D0D0D0;
    border: none;
}

QToolButton#inspectorSectionMenu {
    background: transparent;
    border: none;
    border-radius: 4px;
    min-width: 24px;
    max-width: 24px;
    min-height: 24px;
    color: #8a8a8a;
}

QToolButton#inspectorSectionMenu:hover {
    background: #3a3a3a;
    color: #E8E8E8;
}

QWidget#inspectorSectionBody {
    background: transparent;
    border: none;
    border-radius: 0;
}

QWidget#inspectorSectionBody QDoubleSpinBox,
QWidget#inspectorSectionBody QSpinBox,
QWidget#inspectorSectionBody QLineEdit {
    background: #1f1f1f;
    border: 1px solid #151515;
    border-radius: 3px;
    min-height: 26px;
}

QWidget#inspectorSectionBody QDoubleSpinBox:focus,
QWidget#inspectorSectionBody QSpinBox:focus,
QWidget#inspectorSectionBody QLineEdit:focus {
    border-color: #bd93f9;
}

QWidget#inspectorVector {
    background: transparent;
    border: none;
}

QWidget#inspectorVector QDoubleSpinBox,
QWidget#inspectorVector QSpinBox {
    min-width: 0;
}

QWidget#inspectorBoolField {
    background: #1f1f1f;
    border: 1px solid #151515;
    border-radius: 4px;
}

QWidget#inspectorColorField {
    background: #1f1f1f;
    border: 1px solid #151515;
    border-radius: 4px;
}

QComboBox#inspectorLayerField, QToolButton#inspectorMaskField {
    background: #1f1f1f;
    border: 1px solid #151515;
    border-radius: 3px;
    min-height: 26px;
    padding: 1px 6px;
}

QLabel#inspectorAxisLabel {
    color: #8a8a8a;
    font-size: 11px;
    font-weight: 600;
    min-width: 10px;
}

QLabel#inspectorAxisLabel[axis="x"] {
    color: #e84d5b;
}

QLabel#inspectorAxisLabel[axis="y"] {
    color: #58b96f;
}

QLabel#inspectorAxisLabel[axis="z"] {
    color: #4d9de0;
}

QLabel#inspectorAxisLabel[axis="w"] {
    color: #b588d8;
}

QPushButton#inspectorAddButton {
    background: #323232;
    border: 1px solid #444444;
    border-radius: 4px;
    min-height: 24px;
    padding: 1px 8px;
    color: #dedede;
    font-weight: 600;
}

QPushButton#inspectorAddButton:hover {
    background: #3a3a3a;
    border-color: #5c5c5c;
    color: #ffffff;
}

QLineEdit#inspectorAddSearch {
    background: #2a2a2a;
    border: 1px solid #1f1f1f;
    border-radius: 4px;
    padding: 3px 6px;
    min-height: 20px;
    color: #b0b0b0;
}

QLineEdit#inspectorAddSearch:focus {
    border-color: #bd93f9;
}

QLineEdit#consoleSearch, QLineEdit#historySearch,
QComboBox#consoleLevelFilter {
    min-height: 24px;
    background: #1f1f1f;
    border: 1px solid #151515;
    border-radius: 3px;
}

QToolButton#consoleToolButton, QToolButton#historyToolButton {
    background: #2e2e2e;
    border: 1px solid #1f1f1f;
    border-radius: 3px;
    min-width: 26px;
    max-width: 26px;
    min-height: 24px;
    padding: 0;
}

QToolButton#consoleToolButton:hover, QToolButton#historyToolButton:hover {
    background: #3a3a3a;
    border-color: #555555;
}

QListWidget#consoleList, QListWidget#historyList {
    background: #1f1f1f;
    border: 1px solid #151515;
    border-radius: 3px;
    padding: 2px;
}

QListWidget#consoleList::item, QListWidget#historyList::item {
    border-radius: 2px;
    margin: 0;
    padding: 3px 6px;
}

QPlainTextEdit#scriptEditor {
    background: #1a1a1e;
    color: #d4d4d4;
    border: none;
    selection-background-color: #443a5e;
    selection-color: #ffffff;
}

QTreeWidget#scriptOutline {
    background: #1f1f1f;
    border: 1px solid #151515;
    border-radius: 3px;
    padding: 2px;
}

QLineEdit#scriptOutlineFilter {
    min-height: 24px;
    background: #1f1f1f;
    border: 1px solid #151515;
    border-radius: 3px;
}

QWidget#scriptToolbar {
    background: transparent;
    border: none;
}

QWidget#scriptToolbar QToolButton {
    background: #2e2e2e;
    border: 1px solid #1f1f1f;
    border-radius: 3px;
    padding: 3px 10px;
}

QWidget#scriptToolbar QToolButton:hover {
    background: #3a3a3a;
    border-color: #555555;
}

QTabWidget#scriptTabs::pane {
    border: none;
    border-top: 1px solid #151515;
}

QTabWidget#scriptTabs > QTabBar::tab {
    background: #242424;
    color: #b0b0b0;
    border: 1px solid #1f1f1f;
    border-bottom: none;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    padding: 4px 10px;
    margin-right: 1px;
}

QTabWidget#scriptTabs > QTabBar::tab:selected {
    background: #1a1a1e;
    color: #e8e8e8;
    border-color: #333333;
}

QWidget#scriptFindBar {
    background: #1f1f1f;
    border-top: 1px solid #151515;
}

QWidget#scriptFindBar QLineEdit {
    min-height: 24px;
    background: #242424;
    border: 1px solid #151515;
    border-radius: 3px;
}

QWidget#scriptFindBar QToolButton {
    background: #2e2e2e;
    border: 1px solid #1f1f1f;
    border-radius: 3px;
    padding: 3px 8px;
}

QWidget#scriptFindBar QToolButton:hover {
    background: #3a3a3a;
    border-color: #555555;
}

QLabel#scriptStatus {
    color: #8a8a8a;
    background: #1d1d1d;
    border-top: 1px solid #1f1f1f;
    padding: 2px 8px;
}

QLabel#scriptEmptyLabel {
    color: #7a7a7a;
    font-size: 13px;
}

QScrollBar:vertical {
    background: #242424;
    width: 8px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #3a3a3a;
    border: none;
    min-height: 28px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background: #555555;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background: #242424;
    height: 8px;
}

QScrollBar::handle:horizontal {
    background: #3a3a3a;
    border: none;
    min-width: 28px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal:hover {
    background: #555555;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical,
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal,
QScrollBar::corner {
    background: #242424;
}

QSlider::groove:horizontal {
    background: #1f1f1f;
    height: 3px;
}

QSlider::handle:horizontal {
    background: #a0a0a0;
    width: 9px;
    margin: -4px 0;
    border-radius: 4px;
}

QSlider::handle:horizontal:hover {
    background: #c6c6c6;
}

QCheckBox {
    color: #d8d8d8;
    spacing: 5px;
}

QCheckBox::indicator {
    width: 13px;
    height: 13px;
    border: 1px solid #3A3A3A;
    border-radius: 3px;
    background: #2e2e2e;
}

QCheckBox::indicator:checked {
    background: #bd93f9;
    border-color: #9d7ae0;
}

QLabel {
    color: #d8d8d8;
}

QStatusBar {
    background: #151515;
    color: #a0a0a0;
    border-top: 1px solid #1f1f1f;
}

QSplitter, ads--CDockSplitter {
    qproperty-handleWidth: 5;
}

QSplitter::handle:horizontal,
ads--CDockSplitter::handle:horizontal {
    background: #151515;
    width: 5px;
}

QSplitter::handle:vertical,
ads--CDockSplitter::handle:vertical {
    background: #151515;
    height: 5px;
}

QSplitter::handle:hover,
ads--CDockSplitter::handle:hover {
    background: #bd93f9;
}

ads--CDockContainerWidget,
ads--CDockSplitter,
ads--CFloatingDockContainer {
    background: #151515;
    border: 1px solid #1f1f1f;
    border-radius: 8px;
    margin: 0;
    padding: 0;
}

ads--CFloatingDockContainer ads--CDockContainerWidget {
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

ads--CDockAreaWidget {
    background: #151515;
    border: none;
    margin: 2px;
    padding: 0;
}

ads--CDockManager {
    background: #151515;
}

ads--CDockWidget {
    background: #242424;
    border: 1px solid #1f1f1f;
    border-top: none;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    margin: 0;
    padding: 0;
}

ads--CDockWidget QScrollArea#dockWidgetScrollArea {
    padding: 0;
    border: none;
    background: #242424;
}

ads--CDockAreaTabBar {
    background: #242424;
    border: none;
    padding: 0;
    qproperty-drawBase: false;
}

ads--CDockAreaTitleBar {
    background: #242424;
    padding: 3px 4px 2px;
    border: 1px solid #1f1f1f;
    min-height: 30px;
    max-height: 30px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
}

ads--CDockWidgetTab {
    background: transparent;
    color: #a0a0a0;
    padding: 5px 10px 4px;
    border: none;
    margin: 2px 1px;
    font-size: 12px;
    font-weight: normal;
    min-width: 50px;
    border-radius: 5px;
}

ads--CDockWidgetTab[activeTab="true"] {
    background: #323232;
    color: #E8E8E8;
    border-radius: 5px;
}

ads--CDockWidgetTab QLabel {
    background: transparent;
    color: #a0a0a0;
}

ads--CDockWidgetTab[activeTab="true"] QLabel {
    color: #E8E8E8;
}

ads--CDockWidgetTab:hover:!activeTab {
    background: #2c2c2c;
    color: #d8d8d8;
}

ads--CTitleBarButton {
    background: transparent;
    border: none;
    padding: 2px;
    min-width: 22px;
    min-height: 22px;
    border-radius: 4px;
}

ads--CTitleBarButton:hover {
    background: #323232;
}

ads--CAutoHideSideBar {
    background: #151515;
    border: none;
}

ads--CAutoHideTab {
    background: #242424;
    color: #a0a0a0;
    border: 1px solid #1f1f1f;
    border-radius: 8px;
    padding: 6px 10px;
    margin: 2px;
}

ads--CAutoHideTab:hover,
ads--CAutoHideTab[activeTab="true"] {
    background: #323232;
    color: #d8d8d8;
    border-color: #3a3a3a;
}

ads--CAutoHideDockContainer {
    background: #242424;
    border: 1px solid #3a3a3a;
    border-radius: 6px;
    margin: 0;
}

ads--CAutoHideDockContainer #autoHideDockArea {
    background: #242424;
    margin: 0;
    padding: 0;
}

ads--CAutoHideDockContainer ads--CDockAreaTitleBar {
    background: #242424;
    border: none;
    border-bottom: 1px solid #1f1f1f;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
}

ads--CAutoHideDockContainer ads--CDockWidget {
    background: #242424;
    border: none;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
}

ads--CAutoHideDockContainer ads--CResizeHandle {
    background: transparent;
    border: none;
}

QFrame#pmShell {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #1A1F27, stop:1 #151920);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
}

QFrame#pmShell[edgeToEdge="true"] {
    border: none;
    border-radius: 0;
}

QDialog#unsavedChangesDialog {
    background: #242424;
    border: 1px solid #454545;
    border-radius: 10px;
}

QMessageBox {
    background: #242424;
    border: 1px solid #454545;
    border-radius: 10px;
}

QMessageBox QLabel {
    color: #d8d8d8;
}

QDialog#unsavedChangesDialog QWidget#unsavedChangesBody {
    background: #242424;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
}

QLabel#unsavedChangesMessage {
    color: #d8d8d8;
    font-size: 13px;
}

/* ============ Project manager (island dark) ============ */

QWidget#pmTitleBar {
    background: transparent;
}

QLabel#pmLogoMark {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #BD93F9, stop:1 #7C5CD6);
    border-radius: 5px;
    color: #282A36;
    font-size: 13px;
    font-weight: 700;
}

QLabel#pmTitle {
    background: transparent;
    color: #DFE4EC;
    font-size: 13px;
    font-weight: 600;
}

QLabel#pmTitleSmall {
    background: transparent;
    color: #8791A0;
    font-size: 11px;
    font-family: "Consolas", "JetBrains Mono", monospace;
}

QToolButton#pmWinButton {
    background: transparent;
    border: none;
    border-radius: 5px;
    min-width: 32px;
    max-width: 32px;
    min-height: 24px;
    max-height: 24px;
    padding: 0;
}

QToolButton#pmWinButton:hover {
    background: #353B47;
}

QToolButton#pmWinButton:pressed {
    background: #44475A;
}

QToolButton#pmWinClose {
    background: transparent;
    border: none;
    border-radius: 5px;
    min-width: 32px;
    max-width: 32px;
    min-height: 24px;
    max-height: 24px;
    padding: 0;
}

QToolButton#pmWinClose:hover {
    background: #FF5555;
}

QToolButton#pmWinClose:pressed {
    background: #C7404B;
}

QWidget#pmMain,
QWidget#pmHead,
QWidget#pmTabs,
QWidget#pmStatusBar,
QWidget#pmGridHost,
QStackedWidget#pmStack {
    background: transparent;
}

QScrollArea#pmScroll,
QScrollArea#pmScroll > QWidget > QWidget {
    background: transparent;
    border: none;
}

QFrame#pmSidebar {
    background: rgba(255, 255, 255, 0.028);
    border: 1px solid rgba(255, 255, 255, 0.055);
    border-radius: 16px;
}

QLabel#pmSideLabel {
    background: transparent;
    color: #6C7685;
    font-size: 11px;
    letter-spacing: 1px;
    padding-left: 6px;
}

QPushButton#pmSideItem {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 8px;
    color: #B9C1CD;
    text-align: left;
    padding: 7px 9px;
    min-height: 18px;
}

QPushButton#pmSideItem:hover {
    background: rgba(255, 255, 255, 0.05);
    color: #E8EDF4;
}

QPushButton#pmSideItem:checked {
    background: rgba(189, 147, 249, 0.10);
    border: 1px solid rgba(189, 147, 249, 0.40);
    color: #F0F4FA;
    font-weight: 600;
}

QLabel#pmViewTitle {
    background: transparent;
    color: #F0F4FA;
    font-size: 17px;
    font-weight: 600;
}

QLabel#pmViewSub {
    background: transparent;
    color: #8791A0;
    font-size: 11px;
    font-family: "Consolas", "JetBrains Mono", monospace;
}

QPushButton#pmBtn {
    background: rgba(255, 255, 255, 0.045);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    color: #C8D0DA;
    padding: 6px 13px;
}

QPushButton#pmBtn:hover {
    background: rgba(255, 255, 255, 0.09);
    border-color: rgba(255, 255, 255, 0.14);
    color: #F0F4FA;
}

QPushButton#pmPrimaryButton {
    background: #BD93F9;
    border: 1px solid #BD93F9;
    border-radius: 8px;
    color: #282A36;
    font-weight: 600;
    padding: 6px 14px;
}

QPushButton#pmPrimaryButton:hover {
    background: #D6B7FF;
    border-color: #D6B7FF;
}

QPushButton#pmPrimaryButton:pressed {
    background: #A57BE8;
    border-color: #A57BE8;
}

QPushButton#pmPrimaryButton:disabled {
    background: #463B63;
    border-color: #463B63;
    color: #8A7FA6;
}

QPushButton#pmTab {
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    border-radius: 0;
    color: #929CAB;
    padding: 7px 12px 8px;
}

QPushButton#pmTab:hover {
    color: #F0F4FA;
    background: rgba(255, 255, 255, 0.03);
}

QPushButton#pmTab:checked {
    color: #F0F4FA;
    border-bottom: 2px solid #BD93F9;
    background: rgba(189, 147, 249, 0.04);
}

QFrame#pmCard {
    background: rgba(255, 255, 255, 0.038);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 12px;
}

QFrame#pmCard[sel="true"] {
    background: #2B2536;
    border: 1px solid #BD93F9;
}

QWidget#pmCardBody {
    background: transparent;
}

QWidget#pmCardPreview {
    background: transparent;
}

QLabel#pmCardName {
    background: transparent;
    color: #EDF1F7;
    font-size: 13px;
    font-weight: 600;
}

QLabel#pmCardPath {
    background: transparent;
    color: #75808E;
    font-size: 10.5px;
    font-family: "Consolas", "JetBrains Mono", monospace;
}

QLabel#pmCardMeta {
    background: transparent;
    color: #7A8391;
    font-size: 10.5px;
    font-family: "Consolas", "JetBrains Mono", monospace;
}

QLabel#pmDot {
    border-radius: 3px;
    background: #5A636F;
}

QLabel#pmDot[state="ok"] {
    background: #4FBF8B;
}

QLabel#pmDot[state="miss"] {
    background: #E07070;
}

QLabel#pmCardPill {
    background: rgba(11, 14, 19, 0.72);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 4px;
    color: #BAC3CF;
    font-size: 10px;
    padding: 2px 6px;
}

QWidget#pmCardTools {
    background: transparent;
}

QToolButton#pmCardTool {
    background: rgba(14, 17, 22, 0.82);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 6px;
    color: #D5DCE6;
    min-width: 26px;
    max-width: 26px;
    min-height: 26px;
    max-height: 26px;
    padding: 0;
}

QToolButton#pmCardTool:hover {
    background: #BD93F9;
    border-color: #BD93F9;
    color: #282A36;
}

QLabel#pmEmptyHint {
    background: transparent;
    color: #76808E;
    font-size: 13px;
}

QLabel#pmStatus {
    background: transparent;
    color: #737D8B;
    font-size: 11px;
    font-family: "Consolas", "JetBrains Mono", monospace;
}

QFrame#pmDialogShell {
    background: #171C24;
    border: 1px solid #303946;
    border-radius: 8px;
}

QWidget#pmDlgBody {
    background: transparent;
}

QScrollArea#pmDlgScroll,
QScrollArea#pmDlgScroll > QWidget > QWidget {
    background: transparent;
    border: none;
}

QWidget#pmDlgHead {
    background: transparent;
    border-bottom: 1px solid #2A3039;
}

QWidget#pmDlgFoot {
    background: #12161C;
    border-top: 1px solid #2A3039;
}

QLabel#pmDlgTitle {
    background: transparent;
    color: #F0F4FA;
    font-size: 16px;
    font-weight: 600;
}

QLabel#pmDlgDesc {
    background: transparent;
    color: #8791A0;
    font-size: 11.5px;
}

QPushButton#pmDlgClose {
    background: transparent;
    border: none;
    border-radius: 4px;
    color: #8791A0;
    font-size: 13px;
}

QPushButton#pmDlgClose:hover {
    background: #222933;
    color: #F0F4FA;
}

QLabel#pmFootNote {
    background: transparent;
    color: #6F7987;
    font-size: 10.5px;
    font-family: "Consolas", "JetBrains Mono", monospace;
}

QLabel#pmFieldLabel {
    background: transparent;
    color: #7C8695;
    font-size: 11px;
    letter-spacing: 1px;
}

QLabel#pmHint {
    background: transparent;
    color: #6F7987;
    font-size: 10.5px;
}

QLabel#pmHint[bad="true"] {
    color: #D98585;
}

QPushButton#pmTpl {
    background: #1B2029;
    border: 1px solid #2A3039;
    border-radius: 6px;
    color: #DFE4EC;
    text-align: left;
    padding: 10px 11px;
}

QPushButton#pmTpl:hover {
    background: #212732;
    border-color: #3B4553;
}

QPushButton#pmTpl:checked {
    background: rgba(189, 147, 249, 0.09);
    border: 1px solid #BD93F9;
    color: #EBDDFF;
}

QFrame#pmSummary {
    background: #1B2029;
    border: 1px solid #2A3039;
    border-radius: 6px;
}

QLabel#pmSumKey {
    background: transparent;
    color: #6E7886;
    font-size: 11px;
    font-family: "Consolas", "JetBrains Mono", monospace;
}

QLabel#pmSumValue {
    background: transparent;
    color: #CFD6E0;
    font-size: 11px;
    font-family: "Consolas", "JetBrains Mono", monospace;
}

QFrame#pmSeg {
    background: #1B2029;
    border: 1px solid #2A3039;
    border-radius: 6px;
}

QPushButton#pmSegBtn {
    background: transparent;
    border: none;
    border-radius: 4px;
    color: #9AA4B2;
    padding: 6px 10px;
}

QPushButton#pmSegBtn:hover {
    background: #252C37;
    color: #F0F4FA;
}

QPushButton#pmSegBtn:checked {
    background: #BD93F9;
    color: #282A36;
    font-weight: 600;
}

QPushButton#pmSwitchRow {
    background: #1C222B;
    border: 1px solid #303946;
    border-radius: 5px;
    color: transparent;
    padding: 0;
    min-height: 48px;
}

QPushButton#pmSwitchRow:hover {
    background: #222A35;
    border-color: #465264;
}

QPushButton#pmSwitchRow:checked {
    background: rgba(189, 147, 249, 0.12);
    border: 1px solid rgba(189, 147, 249, 0.65);
}

QLabel#pmSwitchName {
    background: transparent;
    color: #DFE4EC;
    font-size: 12px;
    font-weight: 600;
}

QPushButton#pmSwitchRow:checked QLabel#pmSwitchName {
    color: #EBDDFF;
}

QLabel#pmSwitchDesc {
    background: transparent;
    color: #7A8494;
    font-size: 10.5px;
}

QLabel#pmSwitchPill {
    background: #303A48;
    border: 1px solid #4A5666;
    border-radius: 9px;
    min-width: 34px;
    max-width: 34px;
    min-height: 18px;
    max-height: 18px;
}

QLabel#pmSwitchPill[on="true"] {
    background: #A979E8;
    border: 1px solid #C9A5FF;
}

QLabel#pmSwitchKnob {
    background: #E9E2F8;
    border: 1px solid rgba(40, 42, 54, 0.35);
    border-radius: 6px;
}

QWidget#pmCrumbs {
    background: transparent;
    border-bottom: 1px solid #222831;
}

QPushButton#pmCrumb {
    background: transparent;
    border: none;
    border-radius: 3px;
    color: #8C96A4;
    padding: 2px 6px;
    font-size: 11px;
    font-family: "Consolas", "JetBrains Mono", monospace;
}

QPushButton#pmCrumb:hover {
    background: #222933;
    color: #F0F4FA;
}

QLabel#pmCrumbSlash {
    background: transparent;
    color: #4E5763;
    font-size: 11px;
}

QListWidget#pmFsList {
    background: #12161C;
    border: none;
    padding: 8px;
    outline: none;
}

QListWidget#pmFsList::item {
    border-radius: 5px;
    padding: 7px 10px;
    margin: 1px 2px;
}

QListWidget#pmFsList::item:hover {
    background: #1D242F;
}

QListWidget#pmFsList::item:selected {
    background: rgba(189, 147, 249, 0.16);
    color: #F0F4FA;
}

QLabel#pmFsCur {
    background: transparent;
    color: #8A94A2;
    font-size: 11px;
    font-family: "Consolas", "JetBrains Mono", monospace;
}

QLabel#pmMeta {
    background: transparent;
    border-top: 1px solid #222831;
    color: #77818F;
    font-size: 10.5px;
    font-family: "Consolas", "JetBrains Mono", monospace;
    padding-top: 10px;
}

