/* Cakery Editor — Unity Dark Theme */

QMainWindow {
    background-color: #383838;
    padding: 0px;
    margin: 0px;
}

QMainWindow::separator {
    background-color: #1A1A1A;
    width: 4px;
    height: 4px;
}

QMenuBar {
    background-color: #383838;
    color: #C4C4C4;
    padding: 2px 4px;
    border: none;
}

QMenuBar::item {
    background: transparent;
    padding: 4px 9px;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background-color: #4A4A4A;
}

QMenu {
    background-color: #2D2D2D;
    border: 1px solid #1A1A1A;
    border-radius: 6px;
    padding: 4px;
}

QMenu::item {
    padding: 5px 24px 5px 20px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #2D7DFF;
    color: #FFFFFF;
}

QMenu::separator {
    height: 1px;
    background: #4A4A4A;
    margin: 4px 6px;
}

QToolBar {
    background-color: #333333;
    border: none;
    spacing: 4px;
    padding: 2px 4px;
}

QToolBar#mainToolBar {
    background-color: #2D2D2D;
    border: none;
    border-radius: 8px;
    margin: 0px;
}

QToolButton {
    background-color: transparent;
    color: #C4C4C4;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 4px 7px;
}

QToolButton:hover {
    background-color: #4A4A4A;
    border: 1px solid #1A1A1A;
}

QToolButton:pressed {
    background-color: #2D2D2D;
}

QToolButton:checked {
    background-color: #4A4A4A;
    border: 1px solid #2D7DFF;
    color: #2D7DFF;
}

QPushButton {
    background-color: #4A4A4A;
    color: #C4C4C4;
    border: 1px solid #1A1A1A;
    border-radius: 4px;
    padding: 5px 12px;
}

QPushButton:hover {
    background-color: #555555;
}

QPushButton:pressed {
    background-color: #2D7DFF;
    color: #FFFFFF;
}

QDockWidget {
    background-color: #2D2D2D;
    color: #C4C4C4;
    font-weight: bold;
    titlebar-close-icon: none;
    titlebar-normal-icon: none;
}

QDockWidget::title {
    background-color: #2D2D2D;
    color: #C4C4C4;
    padding: 5px 10px;
    margin: 0px;
    border: none;
    text-align: left;
    min-height: 22px;
}

QDockWidget::close-button,
QDockWidget::float-button {
    background: transparent;
    border: none;
    border-radius: 3px;
    padding: 2px;
    min-width: 14px;
    min-height: 14px;
}

QDockWidget::close-button:hover,
QDockWidget::float-button:hover {
    background-color: #4A4A4A;
}

QDockWidget::close-button:pressed {
    background-color: #FF5A5A;
}

QTreeWidget, QListWidget, QTableWidget, QTreeView, QListView {
    background-color: transparent;
    alternate-background-color: #333333;
    border: none;
    outline: none;
    color: #C4C4C4;
}

QTreeWidget::item, QListWidget::item {
    padding: 3px 0px;
    border: none;
}

QTreeWidget::item:selected, QListWidget::item:selected,
QTableWidget::item:selected {
    background-color: #2D7DFF;
    color: #FFFFFF;
}

QTreeWidget::item:selected:!active, QListWidget::item:selected:!active,
QTableWidget::item:selected:!active {
    background-color: #4A4A4A;
    color: #C4C4C4;
}

QTreeWidget::item:hover, QListWidget::item:hover {
    background-color: #333333;
}

QHeaderView::section {
    background-color: #2D2D2D;
    color: #8C8C8C;
    padding: 4px 6px;
    border: none;
    border-right: 1px solid #1A1A1A;
}

QScrollArea {
    background-color: transparent;
    border: none;
}

QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background-color: #262626;
    color: #C4C4C4;
    border: 1px solid #1A1A1A;
    border-radius: 4px;
    padding: 3px 6px;
    selection-background-color: #2D7DFF;
    selection-color: #FFFFFF;
}

QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
    border: 1px solid #2D7DFF;
}

QComboBox::drop-down {
    border: none;
    width: 18px;
}

QComboBox QAbstractItemView {
    background-color: #2D2D2D;
    border: 1px solid #1A1A1A;
    selection-background-color: #2D7DFF;
    selection-color: #FFFFFF;
    outline: none;
}

QDoubleSpinBox, QSpinBox {
    min-width: 24px;
}

QDoubleSpinBox::up-button, QDoubleSpinBox::down-button,
QSpinBox::up-button, QSpinBox::down-button {
    width: 0px;
    height: 0px;
    border: none;
}

QGroupBox {
    background-color: #333333;
    border: none;
    border-radius: 6px;
    margin-top: 8px;
    padding: 8px 6px 6px 6px;
    font-weight: bold;
    color: #C4C4C4;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 0px;
    right: 0px;
    padding: 5px 10px;
    color: #C4C4C4;
    background-color: #4A4A4A;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
}

QScrollBar:vertical {
    background: transparent;
    width: 12px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #4A4A4A;
    border-radius: 4px;
    min-height: 24px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background: #2D7DFF;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }

QScrollBar:horizontal {
    background: transparent;
    height: 12px;
}

QScrollBar::handle:horizontal {
    background: #4A4A4A;
    border-radius: 4px;
    min-width: 24px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover {
    background: #2D7DFF;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }

QSlider::groove:horizontal {
    background: #262626;
    height: 4px;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background: #8C8C8C;
    width: 10px;
    margin: -4px 0;
    border-radius: 5px;
}

QSlider::handle:horizontal:hover {
    background: #2D7DFF;
}

QCheckBox {
    color: #C4C4C4;
    spacing: 5px;
}

QCheckBox::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid #4A4A4A;
    border-radius: 3px;
    background-color: #262626;
}

QCheckBox::indicator:checked {
    background-color: #2D7DFF;
    border-color: #2D7DFF;
}

QLabel {
    color: #C4C4C4;
}

QStatusBar {
    background-color: #383838;
    color: #8C8C8C;
    border-top: 1px solid #2D2D2D;
}

QSplitter::handle {
    background-color: #1A1A1A;
    width: 1px;
    height: 1px;
}

QSplitter::handle:hover {
    background-color: #2D7DFF;
}

ads--CDockContainerWidget {
    background-color: #2D2D2D;
}

ads--CDockAreaWidget {
    background-color: #2D2D2D;
}

ads--CDockAreaTabBar {
    background-color: #252525;
    border: none;
    padding: 2px 2px 0px 2px;
    qproperty-drawBase: false;
}

ads--CDockAreaTitleBar {
    background-color: #2D2D2D;
    padding: 0px 4px;
    border: none;
    min-height: 22px;
    max-height: 22px;
}

ads--CDockWidgetTab {
    background-color: #252525;
    color: #8C8C8C;
    padding: 4px 10px;
    border: none;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    margin-right: 1px;
    font-size: 11px;
    font-weight: normal;
    min-width: 0px;
}

ads--CDockWidgetTab[activeTab="true"] {
    background-color: #383838;
    color: #C4C4C4;
}

ads--CDockWidgetTab:hover:!activeTab {
    color: #C4C4C4;
    background-color: #303030;
}

ads--CDockSplitter {
    background-color: #2D2D2D;
}

ads--CDockSplitter::handle {
    background-color: #1A1A1A;
    width: 1px;
}

ads--CDockSplitter::handle:hover {
    background-color: #2D7DFF;
}

ads--CFloatingDockContainer {
    background-color: #2D2D2D;
}

#tabCloseButton {
    background: transparent;
    border: none;
    border-radius: 3px;
    min-width: 14px;
    min-height: 14px;
    padding: 0px;
}

#tabCloseButton:hover {
    background-color: #FF5A5A;
}
