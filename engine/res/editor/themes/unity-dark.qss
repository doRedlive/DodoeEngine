/* Cakery editor: dense, planar desktop tooling inspired by modern game editors. */

* {
    font-family: "Segoe UI", "Microsoft YaHei UI", sans-serif;
    font-size: 12px;
}

QMainWindow {
    background: #2b2b2b;
}

QMainWindow::separator {
    background: #1d1d1d;
    width: 1px;
    height: 1px;
}

QMenuBar {
    background: #303030;
    color: #d3d3d3;
    padding: 0 5px;
    border: none;
    border-bottom: 1px solid #1f1f1f;
}

QMenuBar::item {
    background: transparent;
    padding: 5px 8px;
    border: none;
}

QMenuBar::item:selected {
    background: #454545;
    color: #ffffff;
}

QMenu {
    background: #383838;
    color: #dedede;
    border: 1px solid #171717;
    padding: 3px;
}

QMenu::item {
    min-height: 20px;
    padding: 3px 26px 3px 20px;
}

QMenu::item:selected {
    background: #4c83b8;
    color: #ffffff;
}

QMenu::separator {
    height: 1px;
    background: #242424;
    margin: 3px 5px;
}

QToolBar,
QToolBar#editorToolbar {
    background: #383838;
    border: none;
    border-bottom: 1px solid #1e1e1e;
    spacing: 1px;
    padding: 3px 6px;
    min-height: 28px;
}

QToolBar::separator {
    background: #202020;
    width: 1px;
    margin: 3px 7px;
}

QToolBar QLabel {
    color: #dadada;
    font-size: 12px;
    font-weight: 600;
    padding: 0 7px 0 3px;
}

QToolBar QLabel#editorBrand {
    color: #e2e2e2;
    font-weight: 700;
    padding-left: 4px;
    padding-right: 9px;
}

QToolButton {
    background: transparent;
    color: #d0d0d0;
    border: 1px solid transparent;
    border-radius: 2px;
    min-height: 22px;
    padding: 1px 8px;
}

QToolButton:hover {
    background: #4b4b4b;
    border-color: #565656;
    color: #ffffff;
}

QToolButton:pressed,
QToolButton:checked {
    background: #292929;
    border-color: #1a1a1a;
    color: #ffffff;
}

QPushButton {
    background: #4a4a4a;
    color: #e1e1e1;
    border: 1px solid #262626;
    border-radius: 2px;
    min-height: 20px;
    padding: 2px 9px;
}

QPushButton:hover {
    background: #5a5a5a;
    border-color: #666666;
}

QPushButton:pressed {
    background: #343434;
    border-color: #181818;
}

QTreeWidget, QListWidget, QTableWidget, QTreeView, QListView {
    background: #2b2b2b;
    alternate-background-color: #303030;
    border: none;
    color: #d0d0d0;
    outline: none;
}

QTreeWidget::item, QListWidget::item {
    min-height: 20px;
    padding: 1px 4px;
    border: none;
}

QTreeWidget::item:hover, QListWidget::item:hover {
    background: #373737;
}

QTreeWidget::item:selected, QListWidget::item:selected,
QTableWidget::item:selected {
    background: #3f6f98;
    color: #ffffff;
}

QTreeWidget::item:selected:!active, QListWidget::item:selected:!active,
QTableWidget::item:selected:!active {
    background: #414141;
    color: #d0d0d0;
}

QHeaderView::section {
    background: #343434;
    color: #b7b7b7;
    padding: 3px 6px;
    border: none;
    border-right: 1px solid #242424;
    border-bottom: 1px solid #202020;
}

QScrollArea {
    background: #2b2b2b;
    border: none;
}

QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background: #242424;
    color: #dedede;
    border: 1px solid #171717;
    border-radius: 2px;
    min-height: 19px;
    padding: 1px 5px;
    selection-background-color: #4c83b8;
    selection-color: #ffffff;
}

QLineEdit:hover, QSpinBox:hover, QDoubleSpinBox:hover, QComboBox:hover {
    border-color: #4c4c4c;
}

QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
    border-color: #4c83b8;
}

QComboBox::drop-down {
    border: none;
    width: 18px;
}

QComboBox QAbstractItemView {
    background: #383838;
    border: 1px solid #171717;
    selection-background-color: #4c83b8;
    selection-color: #ffffff;
    outline: none;
}

QDoubleSpinBox, QSpinBox {
    min-width: 24px;
}

QDoubleSpinBox::up-button, QDoubleSpinBox::down-button,
QSpinBox::up-button, QSpinBox::down-button {
    width: 0;
    height: 0;
    border: none;
}

QGroupBox {
    background: #333333;
    color: #dddddd;
    border: 1px solid #212121;
    border-radius: 0;
    margin-top: 19px;
    padding: 6px 5px 5px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 0;
    right: 0;
    height: 18px;
    padding: 3px 7px;
    color: #e0e0e0;
    background: #414141;
    border-bottom: 1px solid #252525;
}

QScrollBar:vertical {
    background: #2b2b2b;
    width: 9px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #555555;
    border: 2px solid #2b2b2b;
    min-height: 28px;
}

QScrollBar::handle:vertical:hover {
    background: #777777;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background: #2b2b2b;
    height: 9px;
}

QScrollBar::handle:horizontal {
    background: #555555;
    border: 2px solid #2b2b2b;
    min-width: 28px;
}

QScrollBar::handle:horizontal:hover {
    background: #777777;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

QSlider::groove:horizontal {
    background: #202020;
    height: 3px;
}

QSlider::handle:horizontal {
    background: #a0a0a0;
    width: 9px;
    margin: -4px 0;
    border-radius: 4px;
}

QSlider::handle:horizontal:hover {
    background: #c6c6c6;
}

QCheckBox {
    color: #d0d0d0;
    spacing: 5px;
}

QCheckBox::indicator {
    width: 13px;
    height: 13px;
    border: 1px solid #181818;
    border-radius: 1px;
    background: #252525;
}

QCheckBox::indicator:checked {
    background: #4c83b8;
    border-color: #315d86;
}

QLabel {
    color: #d0d0d0;
}

QStatusBar {
    background: #303030;
    color: #a3a3a3;
    border-top: 1px solid #1e1e1e;
}

QSplitter::handle,
ads--CDockSplitter::handle {
    background: #1e1e1e;
    width: 1px;
    height: 1px;
}

QSplitter::handle:hover,
ads--CDockSplitter::handle:hover {
    background: #4c83b8;
}

ads--CDockContainerWidget,
ads--CDockAreaWidget,
ads--CDockSplitter,
ads--CFloatingDockContainer {
    background: #2b2b2b;
}

ads--CDockAreaTabBar {
    background: #252525;
    border: none;
    border-bottom: 1px solid #1b1b1b;
    padding: 0;
    qproperty-drawBase: false;
}

ads--CDockAreaTitleBar {
    background: #252525;
    padding: 0 4px;
    border: none;
    min-height: 25px;
    max-height: 25px;
}

ads--CDockWidgetTab {
    background: #252525;
    color: #a9a9a9;
    padding: 5px 11px 4px;
    border: none;
    border-top: 2px solid transparent;
    margin: 0;
    font-size: 12px;
    font-weight: normal;
    min-width: 0;
}

ads--CDockWidgetTab[activeTab="true"] {
    background: #2b2b2b;
    color: #f0f0f0;
    border-top-color: #5b9bd5;
}

ads--CDockWidgetTab:hover:!activeTab {
    background: #313131;
    color: #dedede;
}

#tabCloseButton,
#dockAreaCloseButton,
#detachGroupButton,
#tabsMenuButton {
    background: transparent;
    border: none;
    border-radius: 1px;
    min-width: 16px;
    min-height: 16px;
    padding: 0;
}

#tabCloseButton:hover,
#dockAreaCloseButton:hover,
#detachGroupButton:hover,
#tabsMenuButton:hover {
    background: #505050;
}
