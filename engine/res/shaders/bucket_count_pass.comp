#version 450 core

#include "shader_parameter_sets.glsl"

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

struct GpuObjectMeta
{
    uint type;
    uint flags;
    uint material_id;
    uint texture_id;
    uint bounds_id;
    uint data_offset;
    uint reserved0;
    uint reserved1;
};

struct BucketCount
{
    uint instance_count;
    uint current_offset;
    uint pad0;
    uint pad1;
};

struct PrimitiveGpuData
{
    uint transform_index;
    uint mesh_id;
    uint section_start;
    uint section_count;
    uint material_start;
    uint material_count;
    uint index_count;
    uint start_index;
    uint base_vertex;
    uint pad0;
};

layout(std430, set = DOE_SET_PASS, binding = DOE_PASS_BINDING_INPUT0) readonly buffer VisibleObjects  { uint visible_objects[]; };
layout(std430, set = DOE_SET_PASS, binding = DOE_PASS_BINDING_INPUT1) readonly buffer ObjectMetaBuffer { GpuObjectMeta object_meta[]; };
layout(std430, set = DOE_SET_PASS, binding = DOE_PASS_BINDING_INPUT2) readonly buffer VisibleCount { uint visible_count[]; };
layout(std430, set = DOE_SET_PASS, binding = DOE_PASS_BINDING_INPUT3) readonly buffer PrimitiveInstances { PrimitiveGpuData primitive[]; };

layout(std140, set = DOE_SET_PASS, binding = DOE_PASS_BINDING_CONSTANTS) uniform BucketParams
{
    uint object_count;
    uint max_buckets;
    uint pad0;
    uint pad1;
};

layout(std430, set = DOE_SET_PASS, binding = DOE_PASS_BINDING_INPUT4) buffer BucketCounts { BucketCount bucket_counts[]; };

uint getBucketKey(GpuObjectMeta meta, PrimitiveGpuData primitive_data)
{
    uint key = meta.type ^ (meta.material_id * 16777619u);
    key ^= primitive_data.mesh_id * 2166136261u;
    key ^= primitive_data.index_count * 709607u;
    key ^= primitive_data.start_index * 1000003u;
    return key % max_buckets;
}

void main()
{
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= visible_count[0] || idx >= object_count)
        return;

    uint object_idx = visible_objects[idx];
    GpuObjectMeta meta = object_meta[object_idx];
    PrimitiveGpuData primitive_data = primitive[object_idx];

    uint bucket = getBucketKey(meta, primitive_data);
    if (bucket >= max_buckets)
        return;

    atomicAdd(bucket_counts[bucket].instance_count, 1u);
}
