#version 450 core

#include "shader_parameter_sets.glsl"

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

struct DrawIndexedIndirectArgs
{
    uint index_count;
    uint instance_count;
    uint start_index_location;
    int  base_vertex_location;
    uint start_instance_location;
};

layout(std140, set = DOE_SET_PASS, binding = DOE_PASS_BINDING_CONSTANTS) uniform ExpandParams
{
    uvec4 params;
};

layout(std430, set = DOE_SET_PASS, binding = DOE_PASS_BINDING_INPUT0) readonly buffer VisibleFlags  { uint visible_flags[]; };
layout(std430, set = DOE_SET_PASS, binding = DOE_PASS_BINDING_INPUT1) readonly buffer ArgToObject   { uint arg_to_object[]; };
layout(std430, set = DOE_SET_PASS, binding = DOE_PASS_BINDING_INPUT2) readonly buffer CandidateArgs { DrawIndexedIndirectArgs candidate_args[]; };
layout(std430, set = DOE_SET_PASS, binding = DOE_PASS_BINDING_INPUT3) buffer FinalArgs              { DrawIndexedIndirectArgs final_args[]; };

void main()
{
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= params.x)
        return;

    uint object_idx = arg_to_object[idx];
    if (object_idx >= visible_flags.length() || visible_flags[object_idx] == 0u)
        return;

    final_args[idx] = candidate_args[idx];
}
