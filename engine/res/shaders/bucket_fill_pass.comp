#version 450 core

#include "shader_parameter_sets.glsl"

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

struct GpuObjectMeta
{
    uint type;
    uint flags;
    uint material_id;
    uint texture_id;
    uint bounds_id;
    uint data_offset;
    uint reserved0;
    uint reserved1;
};

struct GpuTransform
{
    mat4 local_to_world;
    mat4 world_to_local;
};

struct BucketCount
{
    uint instance_count;
    uint current_offset;
    uint pad0;
    uint pad1;
};

struct DrawIndexedIndirectArgs
{
    uint index_count;
    uint instance_count;
    uint start_index_location;
    int  base_vertex_location;
    uint start_instance_location;
};

layout(std430, set = DOE_SET_PASS, binding = DOE_PASS_BINDING_INPUT0) readonly buffer VisibleObjects  { uint visible_objects[]; };
layout(std430, set = DOE_SET_PASS, binding = DOE_PASS_BINDING_INPUT1) readonly buffer ObjectMetaBuffer { GpuObjectMeta object_meta[]; };
layout(std430, set = DOE_SET_PASS, binding = DOE_PASS_BINDING_INPUT2) readonly buffer TransformBuffer  { GpuTransform transform[]; };
layout(std430, set = DOE_SET_PASS, binding = DOE_PASS_BINDING_INPUT3) buffer BucketCounts    { BucketCount bucket_counts[]; };
layout(std430, set = DOE_SET_PASS, binding = DOE_PASS_BINDING_INPUT4) buffer IndirectArgs   { DrawIndexedIndirectArgs indirect_args[]; };
layout(std430, set = DOE_SET_PASS, binding = DOE_PASS_BINDING_INPUT5) buffer BucketOffsets  { BucketCount bucket_offsets[]; };

uint getBucketKey(GpuObjectMeta meta)
{
    return meta.type & 0xFFu;
}

void main()
{
    uint idx = gl_GlobalInvocationID.x;
    uint object_idx = visible_objects[idx];
    GpuObjectMeta meta = object_meta[object_idx];
    uint bucket = getBucketKey(meta);

    uint slot = atomicAdd(bucket_counts[bucket].current_offset, 1u);

    DrawIndexedIndirectArgs args;
    args.index_count = 6u;
    args.instance_count = 1u;
    args.start_index_location = 0u;
    args.base_vertex_location = 0;
    args.start_instance_location = object_idx;

    indirect_args[slot] = args;
    bucket_offsets[bucket + 1u].instance_count = bucket_counts[bucket].current_offset;
}
