#version 450 core

#include "shader_parameter_sets.glsl"

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

struct GpuObjectMeta
{
    uint type;
    uint flags;
    uint material_id;
    uint texture_id;
    uint bounds_id;
    uint data_offset;
    uint reserved0;
    uint reserved1;
};

struct BucketCount
{
    uint instance_count;
    uint current_offset;
    uint pad0;
    uint pad1;
};

struct BucketRange
{
    uint first_arg;
    uint arg_count;
    uint pad0;
    uint pad1;
};

struct DrawIndexedIndirectArgs
{
    uint index_count;
    uint instance_count;
    uint start_index_location;
    int  base_vertex_location;
    uint start_instance_location;
};

struct PrimitiveGpuData
{
    uint transform_index;
    uint mesh_id;
    uint section_start;
    uint section_count;
    uint material_start;
    uint material_count;
    uint index_count;
    uint start_index;
    uint base_vertex;
    uint pad0;
};

struct BucketTemplateGpu
{
    uint data[16];
};

layout(std430, set = DOE_SET_PASS, binding = DOE_PASS_BINDING_INPUT0) readonly buffer VisibleObjects  { uint visible_objects[]; };
layout(std430, set = DOE_SET_PASS, binding = DOE_PASS_BINDING_INPUT1) readonly buffer ObjectMetaBuffer { GpuObjectMeta object_meta[]; };
layout(std430, set = DOE_SET_PASS, binding = DOE_PASS_BINDING_INPUT2) readonly buffer VisibleCount { uint visible_count[]; };
layout(std430, set = DOE_SET_PASS, binding = DOE_PASS_BINDING_INPUT3) buffer BucketCounts    { BucketCount bucket_counts[]; };
layout(std430, set = DOE_SET_PASS, binding = DOE_PASS_BINDING_INPUT4) buffer IndirectArgs   { DrawIndexedIndirectArgs indirect_args[]; };
layout(std430, set = DOE_SET_PASS, binding = DOE_PASS_BINDING_INPUT6) readonly buffer PrimitiveInstances { PrimitiveGpuData primitive[]; };
layout(std430, set = DOE_SET_PASS, binding = DOE_PASS_BINDING_INPUT7) readonly buffer BucketTemplates { BucketTemplateGpu templates[]; };
layout(std430, set = DOE_SET_PASS, binding = DOE_PASS_BINDING_INPUT8) readonly buffer BucketTemplateMap { uint template_map[]; };
layout(std430, set = DOE_SET_PASS, binding = DOE_PASS_BINDING_INPUT9) readonly buffer BucketBases { uint bucket_bases[]; };
layout(std430, set = DOE_SET_PASS, binding = DOE_PASS_BINDING_INPUT10) buffer BucketRanges  { BucketRange bucket_ranges[]; };

layout(std140, set = DOE_SET_PASS, binding = DOE_PASS_BINDING_CONSTANTS) uniform BucketParams
{
    uint object_count;
    uint max_buckets;
    uint template_count;
    uint pad1;
};

uint getBucketKey(GpuObjectMeta meta, PrimitiveGpuData primitive_data)
{
    uint key = meta.type ^ (meta.material_id * 16777619u);
    key ^= primitive_data.mesh_id * 2166136261u;
    return key;
}

void main()
{
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= visible_count[0] || idx >= object_count)
        return;
    uint object_idx = visible_objects[idx];
    GpuObjectMeta meta = object_meta[object_idx];
    PrimitiveGpuData primitive_data = primitive[object_idx];
    uint raw_key = getBucketKey(meta, primitive_data);
    uint bucket = raw_key % max_buckets;
    if (bucket >= max_buckets)
        return;

    uint template_index = template_map[bucket];
    if (template_index >= template_count)
        return;
    BucketTemplateGpu tpl = templates[template_index];
    if (tpl.data[14] != raw_key)
        return;

    uint bucket_slot = atomicAdd(bucket_counts[bucket].current_offset, 1u);
    uint slot = bucket_bases[bucket] + bucket_slot;

    DrawIndexedIndirectArgs args;
    args.index_count = primitive_data.index_count;
    args.instance_count = 1u;
    args.start_index_location = primitive_data.start_index;
    args.base_vertex_location = int(primitive_data.base_vertex);
    args.start_instance_location = object_idx;

    indirect_args[slot] = args;
    if (bucket_slot == 0u) {
        bucket_ranges[bucket].first_arg = slot;
    }
    atomicMax(bucket_ranges[bucket].arg_count, bucket_slot + 1u);
}
